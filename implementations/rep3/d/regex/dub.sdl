name "regex"
description "A backtracking regular-expression engine (Perl-style leftmost, greedy, ordered choice) with a batch command-line tool"
authors "Peter Alexander"
license "MIT"
copyright "Copyright (c) 2026"

// The first configuration is the default for `dub build`: the CLI tool.
configuration "cli" {
    targetType "executable"
    targetName "regex-cli"
    targetPath "bin"
    sourcePaths "source" "app"
    mainSourceFile "app/main.d"
}

// What other packages get when they depend on "regex".
configuration "library" {
    targetType "library"
    targetName "regex"
    targetPath "bin"
    sourcePaths "source"
}

// Used by `dub test`: library sources plus the separate test files.
configuration "unittest" {
    targetType "library"
    targetName "regex-test"
    targetPath "bin"
    sourcePaths "source" "tests"
}
