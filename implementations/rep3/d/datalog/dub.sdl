name "datalog"
description "Datalog engine with stratified negation (semi-naive bottom-up evaluation)"
authors "Peter Alexander"
copyright "Copyright © 2026"
license "MIT"
targetPath "bin"

// Default configuration: the command-line tool (reads a program on stdin).
configuration "cli" {
    targetType "executable"
    targetName "datalog"
    sourcePaths "source" "app"
    importPaths "source"
    mainSourceFile "app/main.d"
}

// Use this configuration (subConfiguration "datalog" "library") when
// depending on the package as a library.
configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}

// `dub test`: the library plus the unit tests in tests/.
configuration "unittest" {
    targetType "library"
    targetName "datalog-test"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
