name "bigint"
description "Arbitrary-precision signed integer arithmetic in base 10^9"
authors "bigint contributors"
license "MIT"
copyright "Copyright (c) bigint contributors"
targetType "executable"
targetPath "bin"
targetName "bigint"

# Default configuration: the command-line tool (library + app/main.d).
configuration "cli" {
    targetType "executable"
    sourcePaths "source"
    mainSourceFile "app/main.d"
    sourceFiles "app/main.d"
}

# Library only, for use as a dependency.
configuration "library" {
    targetType "library"
    sourcePaths "source"
    excludedSourceFiles "app/main.d"
}

# Used by `dub test`: library sources plus the separate test modules.
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
}
