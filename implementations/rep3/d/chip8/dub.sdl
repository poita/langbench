name "chip8"
description "A deterministic CHIP-8 interpreter: reusable library plus a command-line runner."
authors "Peter Alexander"
license "MIT"
copyright "Copyright © 2026"

targetType "executable"
targetPath "bin"

# Default configuration: the command-line tool (bin/chip8).
configuration "cli" {
    targetType "executable"
    targetName "chip8"
    sourcePaths "source" "app"
    importPaths "source"
    mainSourceFile "app/main.d"
}

# The library alone, for use as a dependency (`dependency "chip8" path="..."`).
configuration "library" {
    targetType "library"
    targetName "chip8"
    sourcePaths "source"
    importPaths "source"
}

# Used by `dub test`: library sources plus the unit tests in tests/.
configuration "unittest" {
    targetType "executable"
    targetName "chip8-unittest"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
    mainSourceFile "tests/test_main.d"
}
