{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}
 :aliases
 {;; clojure -X:test
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/url "https://github.com/cognitect-labs/test-runner.git"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clojure -M:aot  -- AOT-compiles the CLI into target/classes (used by build.sh)
  :aot {:extra-paths ["target/classes"]
        :main-opts ["-e" "(binding [*compile-path* \"target/classes\"] (compile 'sat.cli))"]}

  ;; clojure -M:run < problem.cnf
  :run {:main-opts ["-m" "sat.cli"]}}}
