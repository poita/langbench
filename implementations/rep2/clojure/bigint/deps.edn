{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.6"}}

 :aliases
 {;; clojure -M:run < queries.txt
  :run   {:extra-paths ["classes"]
          :main-opts   ["-m" "bigint.cli"]}

  ;; clojure -M:build   (ahead-of-time compiles the CLI into ./classes)
  :build {:extra-paths ["classes"]
          :main-opts   ["-e" "(compile 'bigint.cli)"]}

  ;; clojure -M:test
  :test  {:extra-paths ["test"]
          :extra-deps  {io.github.cognitect-labs/test-runner
                        {:git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                        org.clojure/test.check {:mvn/version "1.1.1"}}
          :main-opts   ["-m" "cognitect.test-runner"]
          :exec-fn     cognitect.test-runner.api/test}}}
