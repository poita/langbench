name "jq"
description "A jq-subset query language: JSON parser, serializer and filter interpreter, plus a CLI"
authors "jq-d contributors"
copyright "Copyright © 2026, jq-d contributors"
license "MIT"

configuration "application" {
    targetType "executable"
    targetName "jq"
    mainSourceFile "app/main.d"
    sourcePaths "source" "app"
    importPaths "source"
}

configuration "library" {
    targetType "library"
    targetName "jq"
    sourcePaths "source"
    importPaths "source"
}
