name "regex"
description "A backtracking regular-expression engine (Perl-style leftmost-first semantics) with a batch CLI"
authors "Peter Alexander"
license "MIT"
copyright "Copyright © 2026"
targetType "autodetect"

configuration "cli" {
    targetType "executable"
    targetName "regex"
    mainSourceFile "source/app.d"
}

configuration "library" {
    targetType "library"
    excludedSourceFiles "source/app.d"
}
