{
    "name": "datalog",
    "description": "A Datalog engine with stratified negation (semi-naive bottom-up evaluation)",
    "authors": ["Peter Alexander"],
    "license": "MIT",
    "copyright": "Copyright © 2026",
    "targetType": "executable",
    "targetName": "datalog",
    "targetPath": "bin",
    "mainSourceFile": "app/main.d",
    "sourcePaths": ["source", "app"],
    "importPaths": ["source"],
    "dflags-ldc": ["-O3"],
    "configurations": [
        { "name": "cli", "targetType": "executable" },
        {
            "name": "library",
            "targetType": "library",
            "targetName": "datalog",
            "excludedSourceFiles": ["app/main.d"],
            "sourcePaths": ["source"]
        },
        {
            "name": "unittest",
            "targetType": "library",
            "excludedSourceFiles": ["app/main.d"],
            "sourcePaths": ["source", "tests"],
            "importPaths": ["source", "tests"]
        }
    ]
}
