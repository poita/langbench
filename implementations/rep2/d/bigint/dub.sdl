name "bigint"
description "Arbitrary-precision signed integer arithmetic with a base-10^9 representation"
authors "Peter Alexander"
copyright "Copyright © 2026"
license "MIT"

# Default configuration: the command-line tool (source/app.d + the library).
configuration "cli" {
    targetType "executable"
    targetName "bigint"
}

# Use this configuration when depending on the package as a library.
configuration "library" {
    targetType "library"
    excludedSourceFiles "source/app.d"
}

# Used by `dub test`: library modules only, the unit tests live next to the code.
configuration "unittest" {
    targetType "library"
    excludedSourceFiles "source/app.d"
}
