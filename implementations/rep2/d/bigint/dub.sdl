name "bigint"
description "Arbitrary-precision signed integer arithmetic in pure D (base 10^9 limbs)."
authors "bigint authors"
copyright "Copyright © bigint authors"
license "MIT"

# Default configuration: the command-line tool (reads queries on stdin).
configuration "cli" {
    targetType "executable"
    targetName "bigint-cli"
    sourcePaths "source" "app"
    importPaths "source"
    mainSourceFile "app/main.d"
}

# The reusable library only (use this when depending on the package).
configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}

# Used by `dub test`: library sources plus the unit tests in tests/.
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}

