name "webhooks"
description "Standard Webhooks signing/verification and a deterministic delivery simulator, with SHA-256, HMAC and Base64 written from scratch."
authors "webhooks authors"
license "MIT"
copyright "Copyright (c) webhooks authors"

configuration "cli" {
    targetType "executable"
    targetName "webhooks-cli"
    targetPath "bin"
    sourcePaths "source" "cli"
    importPaths "source"
    mainSourceFile "cli/app.d"
}

configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}

configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source"
}
