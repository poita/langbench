name "depresolve"
description "Deterministic package dependency resolver: depth-first, newest-first, chronological backtracking."
authors "Peter Alexander"
copyright "Copyright © 2026"
license "MIT"
targetPath "bin"

// Default configuration: the command-line tool.
configuration "cli" {
    targetType "executable"
    targetName "depresolve"
    sourcePaths "source" "cli"
    mainSourceFile "cli/app.d"
    importPaths "source"
}

// Use this configuration (subConfiguration "depresolve" "library") to depend
// on the resolver as a plain library without the command-line front end.
configuration "library" {
    targetType "library"
    targetName "depresolve"
    sourcePaths "source"
    importPaths "source"
}

// Used by `dub test`: library sources plus the separate test modules.
configuration "unittest" {
    targetType "library"
    targetName "depresolve-test"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
