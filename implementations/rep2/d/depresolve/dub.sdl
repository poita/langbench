name "depresolve"
description "Deterministic package dependency resolver: depth-first, newest-first, chronological backtracking."
authors "depresolve authors"
copyright "Copyright © 2026, depresolve authors"
license "MIT"
sourcePaths "source"
importPaths "source"

configuration "cli" {
    targetType "executable"
    targetName "depresolve"
    mainSourceFile "source/app.d"
}

configuration "library" {
    targetType "library"
    excludedSourceFiles "source/app.d"
}
