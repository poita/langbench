name "sat"
description "A CDCL SAT solver for DIMACS CNF: reusable library plus a command-line tool"
authors "sat authors"
copyright "Copyright © sat authors"
license "MIT"
sourcePaths "source"
importPaths "source"
targetPath "bin"

configuration "application" {
    targetType "executable"
    targetName "sat"
    mainSourceFile "source/app.d"
}

configuration "library" {
    targetType "library"
    excludedSourceFiles "source/app.d"
}
