/// The built-in hexadecimal font.
module chip8.font;

/// Address at which the font is stored in memory.
enum size_t fontBase = 0x050;

/// Number of bytes per glyph.
enum size_t glyphSize = 5;

/// Font data for the glyphs `0`..`F`, five bytes each.
immutable ubyte[80] fontData = [
    0xF0, 0x90, 0x90, 0x90, 0xF0,
    0x20, 0x60, 0x20, 0x20, 0x70,
    0xF0, 0x10, 0xF0, 0x80, 0xF0,
    0xF0, 0x10, 0xF0, 0x10, 0xF0,
    0x90, 0x90, 0xF0, 0x10, 0x10,
    0xF0, 0x80, 0xF0, 0x10, 0xF0,
    0xF0, 0x80, 0xF0, 0x90, 0xF0,
    0xF0, 0x10, 0x20, 0x40, 0x40,
    0xF0, 0x90, 0xF0, 0x90, 0xF0,
    0xF0, 0x90, 0xF0, 0x10, 0xF0,
    0xF0, 0x90, 0xF0, 0x90, 0x90,
    0xE0, 0x90, 0xE0, 0x90, 0xE0,
    0xF0, 0x80, 0x80, 0x80, 0xF0,
    0xE0, 0x90, 0x90, 0x90, 0xE0,
    0xF0, 0x80, 0xF0, 0x80, 0xF0,
    0xF0, 0x80, 0xF0, 0x80, 0x80,
];

/// Memory address of the glyph for the low nibble of `digit`.
size_t glyphAddress(uint digit) @safe pure nothrow @nogc
{
    return fontBase + (digit & 0xF) * glyphSize;
}

@safe pure nothrow @nogc unittest
{
    assert(glyphAddress(0) == 0x050);
    assert(glyphAddress(0xF) == 0x050 + 75);
    assert(glyphAddress(0x1A) == glyphAddress(0xA));
    assert(fontBase + fontData.length == 0x0A0);
}
