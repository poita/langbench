name "chip8"
description "A deterministic CHIP-8 interpreter library and command-line tool"
authors "Peter Alexander"
copyright "Copyright © 2026, Peter Alexander"
license "MIT"
targetType "executable"
targetName "chip8"
targetPath "bin"

# Default configuration: the command-line tool (library + cli/app.d).
configuration "cli" {
    targetType "executable"
    sourcePaths "source" "cli"
    mainSourceFile "cli/app.d"
}

# Reusable library only; depend on it with `subConfiguration "chip8" "library"`
# (dub selects it automatically for dependents).
configuration "library" {
    targetType "library"
    sourcePaths "source"
    excludedSourceFiles "cli/*"
}

# Used by `dub test`: unit tests live next to the code in `unittest` blocks.
configuration "unittest" {
    targetType "executable"
    targetName "chip8-test"
    sourcePaths "source" "tests"
    mainSourceFile "tests/main.d"
}
