name "kiln"
description "Kiln: an incremental build system with a deterministic parallel-scheduling simulation"
authors "Kiln contributors"
copyright "Copyright © 2026, Kiln contributors"
license "MIT"

# The default configuration builds the `kiln` command-line tool; the
# `library` configuration builds only the reusable engine (kiln.*).
configuration "application" {
    targetType "executable"
    targetName "kiln"
    sourcePaths "source" "app"
    mainSourceFile "app/main.d"
}

configuration "library" {
    targetType "library"
    targetName "kiln"
    sourcePaths "source"
}

# `dub test` runs the unit tests embedded in the library modules plus the
# end-to-end session tests under tests/.
configuration "unittest" {
    targetType "library"
    targetName "kiln-unittest"
    sourcePaths "source" "tests"
}
