CREATE TABLE emp (id INTEGER, name TEXT, dept TEXT, salary INTEGER, age INTEGER);
CREATE TABLE dept (dname TEXT, floor INTEGER, budget INTEGER);
INSERT INTO dept VALUES ('eng', 3, 500);
INSERT INTO dept VALUES ('ops', 2, 1000);
INSERT INTO dept VALUES ('sales', 3, 500);
INSERT INTO dept VALUES ('hr', 2, 250);
INSERT INTO dept VALUES ('archive', NULL, 0);
INSERT INTO emp VALUES (1, 'grace', 'hr', 5600, 40), (2, 'peggy', 'eng', 4800, 59), (3, 'ivan', 'hr', 1900, 46), (4, 'victor', 'eng', 1200, 43), (5, 'x', 'eng', 4500, 29), (6, 'oscar', 'legal', 7300, 52), (7, 'frank', 'eng', NULL, 56);
INSERT INTO emp VALUES (8, 'victor', 'eng', 8800, 49), (9, 'erin', 'ops', 8000, 28), (10, 'erin', 'sales', 1700, 42), (11, 'grace', 'sales', 2900, 33), (12, 'Al', NULL, NULL, 26);
SELECT SUM(e.salary) / COUNT(*), AVG(e.salary) FROM emp e, dept d WHERE e.dept = d.dname;
SELECT * FROM emp WHERE salary > 6185 ORDER BY id;
SELECT dept, age, COUNT(*) FROM emp GROUP BY dept, age HAVING age IS NULL OR COUNT(*) > 1;
SELECT id FROM emp ORDER BY age DESC;
SELECT COUNT(*), SUM(salary), AVG(age), MIN(name), MAX(name) FROM emp WHERE dept IS NULL;
SELECT d.dname, COUNT(*), AVG(e.salary) FROM dept d INNER JOIN emp e ON d.dname = e.dept GROUP BY d.dname HAVING AVG(e.salary) > 4860 ORDER BY 3 DESC, 1;
SELECT name, dept FROM emp ORDER BY dept;
SELECT COUNT(*), SUM(salary), AVG(age), MIN(name), MAX(name) FROM emp WHERE dept IS NULL;
SELECT dept, COUNT(*), SUM(salary), MIN(age), MAX(age), AVG(salary) FROM emp GROUP BY dept;
SELECT e.id, d.floor * 1000 + e.salary FROM emp e JOIN dept d ON e.dept = d.dname WHERE e.salary IS NOT NULL ORDER BY 2 DESC, 1 LIMIT 5;
SELECT name, salary * 2 - age AS s FROM emp WHERE salary % 400 = 0 ORDER BY s, id;
SELECT a.id, b.id FROM emp a JOIN emp b ON a.age = b.age WHERE a.id < b.id ORDER BY a.id, b.id;
SELECT id, name FROM emp WHERE name LIKE '_o%' ORDER BY name, id;
SELECT id, name FROM emp WHERE name NOT LIKE '%a%' AND dept IS NOT NULL ORDER BY id DESC LIMIT 6;
SELECT * FROM emp WHERE salary > 4664 ORDER BY id;
UPDATE emp SET name = 'oscar' WHERE name IS NULL OR name = 'Al';
SELECT name, dept FROM emp ORDER BY dept;
SELECT * FROM emp ORDER BY dept, salary DESC, id;
SELECT COUNT(*), SUM(salary), AVG(age), MIN(name), MAX(name) FROM emp WHERE dept IS NULL;
SELECT a.name, b.name FROM emp a, emp b WHERE a.dept = b.dept AND a.id < b.id AND a.salary > b.salary ORDER BY a.id, b.id;
UPDATE emp SET name = 'trent' WHERE name IS NULL OR name = 'grace';
SELECT a.name, b.name FROM emp a, emp b WHERE a.dept = b.dept AND a.id < b.id AND a.salary > b.salary ORDER BY a.id, b.id;
UPDATE emp SET name = 'bob' WHERE name IS NULL OR name = 'x';
UPDATE emp SET nosuch = 1;
UPDATE dept SET floor = floor + 1 WHERE budget IS NULL;
SELECT d.dname, COUNT(*), AVG(e.salary) FROM dept d INNER JOIN emp e ON d.dname = e.dept GROUP BY d.dname HAVING AVG(e.salary) > 5528 ORDER BY 3 DESC, 1;
UPDATE emp SET salary = salary + 291 WHERE dept = 'hr';
SELECT dname FROM emp e, dept d WHERE name = d;
UPDATE emp SET salary = salary + -487 WHERE dept = 'hr';
DELETE FROM emp WHERE salary < 2262;
SELECT COUNT(*) FROM emp;
