CREATE TABLE emp (id INTEGER, name TEXT, dept TEXT, salary INTEGER, age INTEGER);
CREATE TABLE dept (dname TEXT, floor INTEGER, budget INTEGER);
INSERT INTO dept VALUES ('eng', 4, 100);
INSERT INTO dept VALUES ('ops', 4, NULL);
INSERT INTO dept VALUES ('sales', 4, NULL);
INSERT INTO dept VALUES ('archive', NULL, 0);
INSERT INTO emp VALUES (1, 'heidi', 'ops', 5100, 47), (2, 'bob', 'sales', 7300, 22), (3, 'frank', 'eng', 4300, 33), (4, 'dave', 'ops', 3500, 35), (5, 'oscar', 'sales', 6800, NULL), (6, 'oscar', 'ops', 6000, 56), (7, 'trent', 'sales', 2400, NULL);
INSERT INTO emp VALUES (8, 'alice', 'hr', 5000, 30), (9, '', 'sales', NULL, 28), (10, 'Bea', 'hr', 1100, 48), (11, '', 'hr', 8200, 60), (12, 'bob', 'eng', 1000, 53), (13, 'carol', 'hr', NULL, NULL), (14, 'trent', 'ops', 7000, NULL);
INSERT INTO emp VALUES (15, 'heidi', 'ops', 3600, 46), (16, NULL, 'sales', 8600, 44), (17, 'peggy', 'hr', NULL, 35), (18, '', 'hr', 7800, 36), (19, 'heidi', 'sales', 8000, 59), (20, 'ivan', 'sales', 8900, 23);
SELECT dname FROM emp e, dept d WHERE name = d;
SELECT salary, COUNT(*) FROM emp GROUP BY salary HAVING COUNT(*) >= 2;
SELECT e.name, d.budget FROM emp AS e INNER JOIN dept AS d ON e.dept = d.dname ORDER BY d.budget DESC, e.name, e.id LIMIT 10 OFFSET 4;
SELECT id, name FROM emp WHERE name LIKE '%Y' ORDER BY name, id;
SELECT age / 10, COUNT(*), AVG(salary) FROM emp WHERE age IS NOT NULL GROUP BY age ORDER BY 1, 2 DESC, age;
UPDATE emp SET name = 'judy' WHERE name IS NULL OR name = 'grace';
SELECT * FROM emp ORDER BY dept, salary DESC, id;
SELECT name, salary FROM emp WHERE dept = 'sales' OR age < 38 ORDER BY salary DESC, id;
SELECT dept, COUNT(*), SUM(salary), MIN(age), MAX(age), AVG(salary) FROM emp GROUP BY dept;
SELECT * FROM emp WHERE;
INSERT INTO emp VALUES (21, 'judy', 'hr', 8400, 23);
SELECT * FROM emp ORDER BY dept, salary DESC, id;
SELECT e.id, d.floor * 1000 + e.salary FROM emp e JOIN dept d ON e.dept = d.dname WHERE e.salary IS NOT NULL ORDER BY 2 DESC, 1 LIMIT 5;
DELETE FROM emp WHERE salary < 1541;
SELECT COUNT(*), SUM(salary), AVG(age), MIN(name), MAX(name) FROM emp WHERE dept IS NULL;
SELECT e.name, d.floor FROM emp e, dept d WHERE e.dept = d.dname AND d.floor > 2 ORDER BY e.id;
UPDATE emp SET name = 'trent' WHERE name IS NULL OR name = 'oscar';
SELECT age / 10, COUNT(*), AVG(salary) FROM emp WHERE age IS NOT NULL GROUP BY age ORDER BY 1, 2 DESC, age;
DELETE FROM emp WHERE salary < 1412;
UPDATE dept SET floor = floor + 1 WHERE budget IS NULL;
UPDATE emp SET name = 'Bea' WHERE name IS NULL OR name = 'alice';
SELECT a.id, b.id FROM emp a JOIN emp b ON a.age = b.age WHERE a.id < b.id ORDER BY a.id, b.id;
SELECT id, name FROM emp WHERE name LIKE '_' ORDER BY name, id;
SELECT SUM(e.salary) / COUNT(*), AVG(e.salary) FROM emp e, dept d WHERE e.dept = d.dname;
SELECT COUNT(*), SUM(salary), AVG(age), MIN(name), MAX(name) FROM emp WHERE dept IS NULL;
SELECT COUNT(*), SUM(salary), AVG(age), MIN(salary), MAX(age) FROM emp WHERE dept = NULL;
SELECT id, age, age IS NULL, age > 48, NOT age > 57 FROM emp WHERE id % 3 = 0 ORDER BY id;
