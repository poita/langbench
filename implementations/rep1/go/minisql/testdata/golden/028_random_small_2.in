SELECT * FROM emp WHERE salary > 8655 ORDER BY id;
SELECT nosuch FROM emp;
SELECT nosuch FROM emp;
SELECT id, age, age IS NULL, age > 23, NOT age > 40 FROM emp WHERE id % 3 = 0 ORDER BY id;
SELECT * FROM emp WHERE age IS NULL;
SELECT SUM(e.salary) / COUNT(*), AVG(e.salary) FROM emp e, dept d WHERE e.dept = d.dname;
SELECT * FROM emp WHERE salary > 6969 ORDER BY id;
SELECT SUM(e.salary) / COUNT(*), AVG(e.salary) FROM emp e, dept d WHERE e.dept = d.dname;
UPDATE emp SET name = 'bob' WHERE name IS NULL OR name = 'grace';
SELECT id, name FROM emp WHERE NOT (age > 53 AND dept = 'ops') ORDER BY id LIMIT 9;
SELECT dept, COUNT(*), SUM(salary), MIN(age), MAX(age), AVG(salary) FROM emp GROUP BY dept;
SELECT age / 10, COUNT(*), AVG(salary) FROM emp WHERE age IS NOT NULL GROUP BY age ORDER BY 1, 2 DESC, age;
