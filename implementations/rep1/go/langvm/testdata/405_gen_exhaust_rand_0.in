@module main
enum Color { Red, Green, Blue }
enum Shape { Dot, Seg(Int), Box(Int, Int), Tagged(Color, Shape) }
fn dc(c: Color) -> Str { match c { Red -> "R", Green -> "G", Blue -> "B" } }
fn ds(s: Shape) -> Str {
    match s {
        Dot -> ".",
        Seg(n) -> "S" ++ showInt(n),
        Box(a, b) -> "B" ++ showInt(a) ++ "x" ++ showInt(b),
        Tagged(c, t) -> dc(c) ++ "<" ++ ds(t) ++ ">",
    }
}
fn dopt(o: Option<Shape>) -> Str { match o { Some(s) -> "?" ++ ds(s), None -> "-" } }
fn dl(xs: [Int]) -> Str { "[" ++ strJoin(listMap(xs, |v| showInt(v)), " ") ++ "]" }
fn g(x0: Shape, x1: Bool) -> Str {
    match (x0, x1) {
        (_, false) -> "0",
        (Tagged(Red, Dot), false) -> "1",
        (Box(0, _), true) -> "2",
        (Seg(-1), _) -> "3",
        (Seg(1), false) -> "4",
        (Dot, false) -> "5",
        (Tagged(Green, Seg(_)), false) -> "6",
    }
}
fn main() {
    print(g(Tagged(Blue, Tagged(Green, Dot)), false));
}
