{
  "schema": {
    "type": "string",
    "pattern": "^[1-5](?:[0-9]{2}|XX)$"
  },
  "tests": [
    {
      "description": "a status code",
      "data": "404"
    },
    {
      "description": "a wildcard code",
      "data": "4XX"
    },
    {
      "description": "out of range",
      "data": "600"
    },
    {
      "description": "trailing text",
      "data": "404 Not Found"
    }
  ]
}
