=== base
<base>{% block b0 %}base-b0{% endblock %}
{% block b1 %}base-b1{% endblock %}
{% block b2 %}base-b2{% endblock %}
{% block b3 %}base-b3{% endblock %}
{% block b4 %}base-b4({% block b4_in %}in-b4{% endblock %}){% endblock %}
{% block b5 %}base-b5({% block b5_in %}in-b5{% endblock %}){% endblock %}
