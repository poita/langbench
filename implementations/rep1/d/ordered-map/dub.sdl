name "ordered-map"
description "Balanced ordered map (AVL tree with order statistics) and a line-oriented command-line tool"
authors "Peter Alexander"
license "MIT"
copyright "Copyright © 2026, Peter Alexander"
targetPath "bin"

configuration "cli" {
    targetType "executable"
    targetName "ordered-map"
    sourcePaths "source" "cli"
    mainSourceFile "cli/app.d"
}

configuration "library" {
    targetType "library"
    sourcePaths "source"
}
