name "buildsys"
description "Kiln: an incremental build system with a deterministic parallel-build simulator"
authors "buildsys contributors"
copyright "Copyright © buildsys contributors"
license "MIT"

targetName "kiln"
targetPath "bin"

// The default configuration builds the command-line tool.  The library
// configuration builds only the reusable `kiln` package (`import kiln;`).
configuration "application" {
    targetType "executable"
    sourcePaths "source" "app"
    importPaths "source"
    mainSourceFile "app/main.d"
}

configuration "library" {
    targetType "library"
    targetName "kiln"
    sourcePaths "source"
    importPaths "source"
}
