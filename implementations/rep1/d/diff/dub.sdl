name "myersdiff"
description "Exact line-oriented Myers diff (linear space) and patch library with a command-line tool"
authors "myersdiff authors"
copyright "Copyright © myersdiff authors"
license "MIT"

# The default configuration builds the command-line tool, `diff`.
configuration "cli" {
    targetType "executable"
    targetName "diff"
    targetPath "bin"
    sourcePaths "source" "app"
    importPaths "source"
    mainSourceFile "app/main.d"
}

# Library only: `dependency "myersdiff" ...` with `subConfiguration "myersdiff" "library"`.
configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}
