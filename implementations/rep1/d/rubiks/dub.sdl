name "rubiks"
description "Rubik's cube solver library and CLI using Thistlethwaite's four-phase algorithm"
authors "Peter Alexander"
copyright "Copyright © 2026"
license "MIT"

// The default configuration builds the command-line tool; the `library`
// configuration (selected automatically when this package is used as a
// dependency) leaves out the CLI entry point.
configuration "application" {
    targetType "executable"
    targetName "rubiks"
    mainSourceFile "source/app.d"
}

configuration "library" {
    targetType "library"
    targetName "rubiks"
    excludedSourceFiles "source/app.d"
}
