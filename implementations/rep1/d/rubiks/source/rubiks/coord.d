/**
 * Coordinates: small integers that identify a cube's coset for each phase of
 * Thistlethwaite's algorithm, together with the ranking helpers they need.
 *
 * $(TABLE
 *  $(TR $(TH Phase) $(TH Coordinate) $(TH Values))
 *  $(TR $(TD 1) $(TD orientation of 11 edges) $(TD 2048))
 *  $(TR $(TD 2) $(TD orientation of 7 corners x positions of the 4 E-slice edges) $(TD 2187 x 495))
 *  $(TR $(TD 3) $(TD half-turn class of the corner permutation x positions of the M-slice edges in the U/D layers) $(TD 420 x 70))
 *  $(TR $(TD 4) $(TD index of the corner permutation in the half-turn group x permutation of each slice) $(TD 96 x 24^3))
 * )
 */
module rubiks.coord;

import rubiks.cubie;
import rubiks.moves;

// ---------------------------------------------------------------- sizes

enum uint numFlip = 2048;          /// phase 1: 2^11
enum uint numTwist = 2187;         /// 3^7
enum uint numSlice = 495;          /// C(12,4)
enum uint numPhase2 = numTwist * numSlice; /// 1,082,565
enum uint numCornerClasses = 420;  /// 8! / 96
enum uint numMSlice = 70;          /// C(8,4)
enum uint numPhase3 = numCornerClasses * numMSlice; /// 29,400
enum uint numHalfCorners = 96;     /// corner permutations generated by half turns
enum uint numPerm4 = 24;           /// 4!
enum uint numPhase4 = numHalfCorners * numPerm4 * numPerm4 * numPerm4; /// 1,327,104
enum uint numCornerPerms = 40320;  /// 8!

// ----------------------------------------------------------- permutations

/// Lehmer-code rank (0 for the identity) of a permutation of `0 .. p.length`.
uint rankPerm(const(ubyte)[] p) pure nothrow @safe @nogc
{
    const n = cast(uint) p.length;
    uint r = 0;
    foreach (i; 0 .. n)
    {
        uint c = 0;
        foreach (j; i + 1 .. n)
            if (p[j] < p[i])
                ++c;
        r = r * (n - i) + c;
    }
    return r;
}

/// Inverse of `rankPerm`: fills `p` (whose length selects n) with the
/// permutation of the given rank.
void unrankPerm(uint rank, ubyte[] p) pure nothrow @safe @nogc
{
    const n = cast(uint) p.length;
    uint[12] digit;
    foreach_reverse (i; 0 .. n)
    {
        digit[i] = rank % (n - i);
        rank /= (n - i);
    }
    uint avail = (1u << n) - 1;
    foreach (i; 0 .. n)
    {
        uint skip = digit[i];
        uint v = 0;
        while (true)
        {
            if (avail & (1u << v))
            {
                if (skip == 0)
                    break;
                --skip;
            }
            ++v;
        }
        avail &= ~(1u << v);
        p[i] = cast(ubyte) v;
    }
}

// ------------------------------------------------------------ k-subsets

/// Maps bit masks with exactly four set bits (out of `bits`) to ranks
/// `0 .. C(bits,4)-1` in increasing mask order, and back.
struct SubsetRanking(uint bits)
{
    /// `rank[mask]` is the rank of a 4-subset mask, `ushort.max` otherwise.
    ushort[1 << bits] rank;
    /// `masks[r]` is the mask with rank `r`.
    ushort[bits == 12 ? 495 : 70] masks;
}

private SubsetRanking!bits buildSubsetRanking(uint bits)() pure nothrow @safe @nogc
{
    SubsetRanking!bits s;
    s.rank[] = ushort.max;
    uint n = 0;
    foreach (mask; 0 .. 1u << bits)
    {
        uint pc = 0;
        foreach (b; 0 .. bits)
            pc += (mask >> b) & 1;
        if (pc == 4)
        {
            s.rank[mask] = cast(ushort) n;
            s.masks[n] = cast(ushort) mask;
            ++n;
        }
    }
    return s;
}

/// Ranking of 4-subsets of the 12 edge positions.
immutable SubsetRanking!12 subsets12 = buildSubsetRanking!12();
/// Ranking of 4-subsets of the 8 U/D-layer edge positions.
immutable SubsetRanking!8 subsets8 = buildSubsetRanking!8();

// -------------------------------------------------- slice position lists

/// Edge positions of the three slices (each is closed under half turns once
/// the cube is in phase 3).
immutable ubyte[4][3] slicePositions = [
    [8, 9, 10, 11], // E slice
    [1, 3, 5, 7],   // M slice (UF UB DF DB)
    [0, 2, 4, 6],   // S slice (UR UL DR DL)
];

/// Index of `edge` within `slicePositions[slice]`, or -1.
int indexInSlice(uint slice, uint edge) pure nothrow @safe @nogc
{
    foreach (k; 0 .. 4)
        if (slicePositions[slice][k] == edge)
            return k;
    return -1;
}

// --------------------------------------------------------- corner groups

/**
 * Lookup tables for the corner permutations: the 96-element group generated
 * by half turns, and the 420 cosets of that group.  A permutation is
 * identified by its Lehmer rank (`rankPerm`).
 */
final class CornerGroup
{
    /// Index `0 .. 95` in the half-turn group for each rank, `ubyte.max` if
    /// the permutation is not in the group.  The identity has index 0.
    ubyte[] halfIndex;
    /// The 96 group members as permutations.
    ubyte[8][] halfPerms;
    /// Class `0 .. 419` of each corner permutation (rank).  The class of
    /// `p` is the set of its relabellings `g . p` by group members `g`.
    ushort[] classOf;
    /// Rank of one representative per class.
    uint[] classRep;

    /// Builds the tables (about 40,000 compositions).
    this() pure nothrow @safe
    {
        halfIndex = new ubyte[numCornerPerms];
        halfIndex[] = ubyte.max;
        classOf = new ushort[numCornerPerms];
        classOf[] = ushort.max;

        // Closure of the identity under the six half turns.
        ubyte[8] id = [0, 1, 2, 3, 4, 5, 6, 7];
        halfPerms ~= id;
        halfIndex[rankPerm(id[])] = 0;
        for (size_t h = 0; h < halfPerms.length; ++h)
        {
            foreach (f; 0 .. numFaces)
            {
                const mc = &moveCubes[f * 3 + 1];
                ubyte[8] q = void;
                foreach (i; 0 .. 8)
                    q[i] = halfPerms[h][mc.cp[i]];
                const r = rankPerm(q[]);
                if (halfIndex[r] == ubyte.max)
                {
                    halfIndex[r] = cast(ubyte) halfPerms.length;
                    halfPerms ~= q;
                }
            }
        }
        assert(halfPerms.length == numHalfCorners);

        // Label cosets in rank order.
        foreach (r; 0 .. numCornerPerms)
        {
            if (classOf[r] != ushort.max)
                continue;
            const cls = cast(ushort) classRep.length;
            classRep ~= r;
            ubyte[8] p = void;
            unrankPerm(r, p[]);
            foreach (ref g; halfPerms)
            {
                ubyte[8] q = void;
                foreach (i; 0 .. 8)
                    q[i] = g[p[i]];
                classOf[rankPerm(q[])] = cls;
            }
        }
        assert(classRep.length == numCornerClasses);
    }
}

// ---------------------------------------------------- coordinate encoding

/// Phase 1 coordinate: orientation of edges 0..10 as a bit mask.
uint flipCoord(in CubieCube c) pure nothrow @safe @nogc
{
    uint v;
    foreach (i; 0 .. 11)
        v |= cast(uint) c.eo[i] << i;
    return v;
}

/// Orientation of corners 0..6 in base 3.
uint twistCoord(in CubieCube c) pure nothrow @safe @nogc
{
    uint v;
    foreach_reverse (i; 0 .. 7)
        v = v * 3 + c.co[i];
    return v;
}

/// Rank of the set of positions holding the four E-slice edges.
uint sliceCoord(in CubieCube c) pure nothrow @safe @nogc
{
    uint mask;
    foreach (i; 0 .. 12)
        if (c.ep[i] >= firstSliceEdge)
            mask |= 1u << i;
    return subsets12.rank[mask];
}

/// Rank of the set of U/D-layer positions holding M-slice edges (pieces
/// UF UB DF DB).  Meaningful when the E-slice edges are in the E slice.
uint mSliceCoord(in CubieCube c) pure nothrow @safe @nogc
{
    uint mask;
    foreach (i; 0 .. 8)
        if (c.ep[i] < 8 && (c.ep[i] & 1))
            mask |= 1u << i;
    return subsets8.rank[mask];
}

/// Permutation (rank 0..23) of the pieces of one slice within its positions.
/// Meaningful when every slice position holds a piece of that slice.
uint slicePermCoord(in CubieCube c, uint slice) pure nothrow @safe @nogc
{
    ubyte[4] p;
    foreach (k; 0 .. 4)
    {
        const j = indexInSlice(slice, c.ep[slicePositions[slice][k]]);
        p[k] = cast(ubyte)(j < 0 ? 0 : j);
    }
    return rankPerm(p[]);
}
