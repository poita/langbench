{
	"name": "scheme",
	"description": "A small Scheme interpreter: reusable library plus a command-line tool",
	"license": "MIT",
	"copyright": "Copyright (c) 2026",
	"authors": ["Peter Alexander"],
	"importPaths": ["source"],
	"configurations": [
		{
			"name": "cli",
			"targetType": "executable",
			"targetName": "scheme",
			"targetPath": "bin",
			"sourcePaths": ["source", "app"],
			"mainSourceFile": "app/main.d"
		},
		{
			"name": "library",
			"targetType": "library",
			"sourcePaths": ["source"]
		},
		{
			"name": "unittest",
			"targetType": "library",
			"sourcePaths": ["source", "tests"],
			"importPaths": ["source", "tests"]
		}
	]
}
