	"targetType": "executable",
	"targetName": "jsonschema",
	"mainSourceFile": "source/app.d",
	"sourcePaths": ["source"],
	"importPaths": ["source"],
	"dflags-ldc": ["-O3"],
	"configurations": [
		{
			"name": "application"
		},
		{
			"name": "unittest",
			"targetName": "jsonschema-test",
			"sourcePaths": ["source", "tests"],
			"importPaths": ["source", "tests"]
		}
	]
}
