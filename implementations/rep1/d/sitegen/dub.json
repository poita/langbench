{
	"name": "sitegen",
	"description": "A static site generator: Markdown, Jinja-style templates and a TOML subset, written from scratch.",
	"authors": ["sitegen contributors"],
	"license": "MIT",
	"copyright": "Copyright 2026, sitegen contributors",
	"targetType": "executable",
	"targetName": "sitegen",
	"targetPath": "bin",
	"configurations": [
		{
			"name": "cli",
			"targetType": "executable",
			"mainSourceFile": "app/main.d",
			"sourcePaths": ["source", "app"],
			"importPaths": ["source"]
		},
		{
			"name": "library",
			"targetType": "library",
			"targetName": "sitegen",
			"excludedSourceFiles": ["app/main.d"],
			"sourcePaths": ["source"],
			"importPaths": ["source"]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"targetName": "sitegen-test",
			"mainSourceFile": "app/main.d",
			"sourcePaths": ["source", "app", "tests"],
			"importPaths": ["source", "tests"]
		}
	]
}
