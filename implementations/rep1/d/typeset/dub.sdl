name "typeset"
description "Codexa typesetting engine: total-fit line breaking, Liang hyphenation, footnotes, floats and a table of contents"
authors "typeset contributors"
copyright "Copyright © typeset contributors"
license "MIT"
sourcePaths "source"
importPaths "source"

# The default configuration builds the command-line tool (build/typeset).
configuration "application" {
    targetType "executable"
    targetName "typeset"
    targetPath "build"
    sourcePaths "source" "app"
    mainSourceFile "app/main.d"
}

# Use this configuration (or the dub package as a dependency) for the library only.
configuration "library" {
    targetType "library"
    targetName "typeset"
}
