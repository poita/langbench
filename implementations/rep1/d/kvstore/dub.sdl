name "tessera"
description "Tessera: an embedded, single-file transactional document store with a write-ahead log and B+tree indexes"
authors "Tessera authors"
license "MIT"
copyright "Copyright (c) Tessera authors"
sourcePaths "source"
importPaths "source"
targetPath "bin"

// `dub build` produces the command-line tool; dependants of the library use
// `subConfiguration "tessera" "library"`.
configuration "cli" {
    targetType "executable"
    targetName "tessera"
    mainSourceFile "source/app.d"
}

configuration "library" {
    targetType "library"
    targetName "tessera"
    excludedSourceFiles "source/app.d"
}
