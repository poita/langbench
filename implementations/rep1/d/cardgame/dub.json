{
	"name": "cardgame",
	"description": "Spiremark: a two-player duelling-card rules engine and match-log simulator",
	"authors": ["cardgame contributors"],
	"license": "MIT",
	"copyright": "Copyright (c) cardgame contributors",
	"targetName": "cardgame",
	"configurations": [
		{
			"name": "cli",
			"targetType": "executable",
			"targetPath": "bin",
			"sourcePaths": ["source", "app"],
			"mainSourceFile": "app/main.d"
		},
		{
			"name": "library",
			"targetType": "library",
			"targetPath": "lib",
			"sourcePaths": ["source"]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "cardgame-tests",
			"sourcePaths": ["source", "tests"],
			"importPaths": ["source", "tests"],
			"mainSourceFile": "tests/main.d"
		}
	]
}
