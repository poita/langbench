name "depresolve"
description "Deterministic package dependency resolver: depth-first, newest-first, chronological backtracking over semver ranges."
authors "depresolve authors"
copyright "Copyright © depresolve authors"
license "MIT"

configuration "cli" {
    targetType "executable"
    targetName "depresolve"
    sourcePaths "source" "app"
    importPaths "source"
}

configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}
