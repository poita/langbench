name "protowire"
description "Protobuf-style wire codec: schema parsing, binary wire format and canonical text form (proto3 semantics)."
authors "protowire contributors"
copyright "Copyright © protowire contributors"
license "MIT"

# The default configuration builds the command-line tool.
configuration "cli" {
    targetType "executable"
    targetName "protowire"
    targetPath "bin"
    sourcePaths "source" "app"
    importPaths "source"
    mainSourceFile "app/main.d"
}

# Library only (for use as a dub dependency).
configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}
