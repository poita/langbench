name "softfloat"
description "Software IEEE-754 binary32 arithmetic (add, sub, mul, div, sqrt) on raw bit patterns"
authors "softfloat contributors"
copyright "Copyright © 2026"
license "MIT"

targetName "softfloat"
targetPath "bin"
importPaths "source"
sourcePaths "source"

# `dub build` builds the command-line tool (the default, first configuration).
configuration "cli" {
    targetType "executable"
    mainSourceFile "app/main.d"
    sourcePaths "source" "app"
    importPaths "source"
}

# `dub build -c library` builds only the reusable library.
configuration "library" {
    targetType "library"
    targetName "softfloat"
}
