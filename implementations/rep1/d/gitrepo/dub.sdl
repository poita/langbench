name "gitrepo"
description "Read a git repository straight off disk: object database, packfiles, refs and revision syntax."
authors "gitrepo contributors"
license "MIT"
copyright "Copyright (c) gitrepo contributors"

# The command-line tool: cli/main.d on top of the library.
configuration "application" {
    targetType "executable"
    targetName "gitrepo"
    targetPath "bin"
    sourcePaths "source" "cli"
    importPaths "source"
    mainSourceFile "cli/main.d"
}

# The library: source/gitrepo/*.d
configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}

# Unit tests live in tests/, separate from the library source.
configuration "unittest" {
    targetType "executable"
    targetName "gitrepo-test"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
    mainSourceFile "tests/runner.d"
}
