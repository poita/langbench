name "typeinfer"
description "Hindley-Milner type inference (Algorithm J) for a small ML-like language"
authors "typeinfer contributors"
copyright "Copyright © 2026"
license "MIT"

configuration "cli" {
    targetType "executable"
    targetName "typeinfer"
    targetPath "bin"
    mainSourceFile "source/app.d"
}

configuration "library" {
    targetType "library"
    excludedSourceFiles "source/app.d"
}
