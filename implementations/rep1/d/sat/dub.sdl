name "sat"
description "A CDCL SAT solver for DIMACS CNF: two watched literals, first-UIP learning, VSIDS, Luby restarts."
authors "sat contributors"
copyright "Copyright © 2026, sat contributors"
license "MIT"
targetPath "bin"

// The command-line tool (first configuration, so it is the default for `dub build`).
configuration "cli" {
    targetType "executable"
    targetName "sat"
    sourcePaths "source" "app"
    mainSourceFile "app/main.d"
}

// The reusable library only.
configuration "library" {
    targetType "library"
    sourcePaths "source"
}
