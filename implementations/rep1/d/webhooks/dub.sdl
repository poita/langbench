name "webhooks"
description "Standard Webhooks: SHA-256, HMAC, Base64, signing/verification and a delivery simulator"
authors "Peter Alexander"
copyright "Copyright © 2026"
license "MIT"
targetType "executable"
targetName "webhooks"
targetPath "bin"

configuration "application" {
    targetType "executable"
    sourcePaths "source" "app"
    importPaths "source"
    mainSourceFile "app/main.d"
}

configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}
