name "qrcode"
description "QR Code Model 2 encoder (ISO/IEC 18004) with a text-matrix command-line tool"
authors "Peter Alexander"
license "MIT"
copyright "Copyright © 2026"

configuration "application" {
    targetType "executable"
    targetName "qrcode"
    sourcePaths "source" "cli"
    importPaths "source"
    mainSourceFile "cli/app.d"
}

configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}
