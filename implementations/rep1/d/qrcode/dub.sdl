name "qrcode"
description "QR Code Model 2 encoder library and command-line tool"
authors "qrcode authors"
license "MIT"
copyright "Copyright © 2026"
targetType "executable"
targetName "qrcode"
targetPath "bin"

# The reusable library lives in src/; app/ holds the thin CLI on top of it.
configuration "application" {
    targetType "executable"
    sourcePaths "src" "app"
    importPaths "src"
    mainSourceFile "app/main.d"
}

configuration "library" {
    targetType "library"
    targetName "qrcode"
    sourcePaths "src"
    importPaths "src"
}

# `dub test` uses this configuration: library sources plus the separate tests/.
configuration "unittest" {
    targetType "executable"
    targetName "qrcode-test"
    sourcePaths "src" "tests"
    importPaths "src"
    mainSourceFile "tests/main.d"
}
