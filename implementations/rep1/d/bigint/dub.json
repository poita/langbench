{
    "name": "bigint",
    "description": "Arbitrary-precision signed integer arithmetic on base-10^9 limbs, with a line-oriented calculator CLI",
    "license": "MIT",
    "copyright": "Copyright 2026",
    "targetPath": "bin",
    "configurations": [
        {
            "name": "cli",
            "targetType": "executable",
            "targetName": "bigint",
            "mainSourceFile": "cli/app.d",
            "sourcePaths": ["source", "cli"],
            "importPaths": ["source"]
        },
        {
            "name": "library",
            "targetType": "library",
            "targetName": "bigint",
            "sourcePaths": ["source"],
            "importPaths": ["source"]
        },
        {
            "name": "unittest",
            "targetType": "library",
            "targetName": "bigint-test",
            "sourcePaths": ["source", "tests"],
            "importPaths": ["source"]
        }
    ]
}
