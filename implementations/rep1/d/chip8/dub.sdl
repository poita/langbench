name "chip8"
description "A deterministic CHIP-8 interpreter library and command-line tool"
authors "chip8 authors"
license "MIT"
copyright "Copyright © 2026"
targetPath "bin"
targetName "chip8"

# Default configuration: the command-line tool (thin wrapper over the library).
configuration "application" {
    targetType "executable"
    sourcePaths "source" "app"
    mainSourceFile "app/main.d"
    importPaths "source"
}

# The reusable library only.
configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}

# Unit tests live in tests/, separate from the library source.
configuration "unittest" {
    targetType "executable"
    sourcePaths "source" "tests"
    importPaths "source"
    mainSourceFile "tests/main.d"
    targetName "chip8-test"
}
