/// The built-in hexadecimal font.
module chip8.font;

/// Address at which the font is stored in memory.
enum ushort fontBase = 0x050;

/// Bytes per glyph.
enum size_t glyphSize = 5;

/// Glyphs for `0`..`F`, five bytes each.
immutable ubyte[80] fontData = [
    0xF0, 0x90, 0x90, 0x90, 0xF0,  0x20, 0x60, 0x20, 0x20, 0x70,
    0xF0, 0x10, 0xF0, 0x80, 0xF0,  0xF0, 0x10, 0xF0, 0x10, 0xF0,
    0x90, 0x90, 0xF0, 0x10, 0x10,  0xF0, 0x80, 0xF0, 0x10, 0xF0,
    0xF0, 0x80, 0xF0, 0x90, 0xF0,  0xF0, 0x10, 0x20, 0x40, 0x40,
    0xF0, 0x90, 0xF0, 0x90, 0xF0,  0xF0, 0x90, 0xF0, 0x10, 0xF0,
    0xF0, 0x90, 0xF0, 0x90, 0x90,  0xE0, 0x90, 0xE0, 0x90, 0xE0,
    0xF0, 0x80, 0x80, 0x80, 0xF0,  0xE0, 0x90, 0x90, 0x90, 0xE0,
    0xF0, 0x80, 0xF0, 0x80, 0xF0,  0xF0, 0x80, 0xF0, 0x80, 0x80,
];

/// Address of the glyph for the low nibble of `digit`.
ushort glyphAddress(ubyte digit) @safe pure nothrow @nogc
{
    return cast(ushort)(fontBase + (digit & 0xF) * glyphSize);
}

@safe pure nothrow @nogc unittest
{
    assert(fontData.length == 16 * glyphSize);
    assert(glyphAddress(0) == 0x050);
    assert(glyphAddress(0xA) == 0x050 + 50);
    assert(glyphAddress(0x1F) == glyphAddress(0xF));
}
