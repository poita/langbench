/// Machine dimensions and the built-in font.
module chip8.constants;

/// Size of the address space in bytes.
enum memorySize = 4096;
/// Mask applied to every memory address and to the program counter.
enum addressMask = 0xFFF;
/// Address at which ROMs are loaded and execution starts.
enum programStart = 0x200;
/// Address of the first font glyph.
enum fontStart = 0x050;
/// Bytes per font glyph.
enum glyphSize = 5;
/// Maximum number of ROM bytes that fit into memory.
enum maxRomSize = memorySize - programStart;
/// Display width in pixels.
enum displayWidth = 64;
/// Display height in pixels.
enum displayHeight = 32;
/// Number of stack entries.
enum stackDepth = 16;
/// Number of keys.
enum keyCount = 16;
/// Initial RNG state.
enum rngSeed = 0x1234_5678u;
/// Cycles between two timer ticks.
enum timerPeriod = 8;

/// The 80-byte font for glyphs `0`..`F`, five bytes each.
immutable ubyte[80] fontData = [
    0xF0, 0x90, 0x90, 0x90, 0xF0,  0x20, 0x60, 0x20, 0x20, 0x70,
    0xF0, 0x10, 0xF0, 0x80, 0xF0,  0xF0, 0x10, 0xF0, 0x10, 0xF0,
    0x90, 0x90, 0xF0, 0x10, 0x10,  0xF0, 0x80, 0xF0, 0x10, 0xF0,
    0xF0, 0x80, 0xF0, 0x90, 0xF0,  0xF0, 0x10, 0x20, 0x40, 0x40,
    0xF0, 0x90, 0xF0, 0x90, 0xF0,  0xF0, 0x90, 0xF0, 0x10, 0xF0,
    0xF0, 0x90, 0xF0, 0x90, 0x90,  0xE0, 0x90, 0xE0, 0x90, 0xE0,
    0xF0, 0x80, 0x80, 0x80, 0xF0,  0xE0, 0x90, 0x90, 0x90, 0xE0,
    0xF0, 0x80, 0xF0, 0x80, 0xF0,  0xF0, 0x80, 0xF0, 0x80, 0x80,
];

static assert(fontData.length == 16 * glyphSize);
