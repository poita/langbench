name "minisql"
description "A small in-memory relational database that executes a subset of SQL"
authors "minisql authors"
copyright "Copyright © minisql authors"
license "MIT"

// The first configuration is what `dub build` produces: the command-line tool.
// Dependants of this package automatically get the "library" configuration.
configuration "cli" {
    targetType "executable"
    targetName "minisql"
    targetPath "bin"
    mainSourceFile "source/app.d"
}

configuration "library" {
    targetType "library"
    excludedSourceFiles "source/app.d"
}
