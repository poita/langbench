name "textbuffer"
description "Text buffer with undo, redo and multiple cursors: the editing core of a text editor."
authors "textbuffer contributors"
copyright "Copyright © textbuffer contributors"
license "MIT"

sourcePaths "source"
importPaths "source"
targetPath "bin"

// The command-line tool (the default configuration, built by `dub build`).
configuration "executable" {
    targetType "executable"
    targetName "textbuffer"
    mainSourceFile "source/app.d"
}

// The reusable library without the CLI, for use as a dependency.
configuration "library" {
    targetType "library"
    targetName "textbuffer"
    excludedSourceFiles "source/app.d"
}
