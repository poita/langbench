name "svgraster"
description "A small, dependency-free rasteriser for a subset of SVG 1.1 that writes binary PPM images."
authors "svgraster authors"
copyright "Copyright © svgraster authors"
license "MIT"

# `dub build` produces the command-line tool; projects that depend on
# "svgraster" automatically get the `library` configuration.
configuration "cli" {
    targetType "executable"
    targetName "svgraster"
    mainSourceFile "source/app.d"
}

configuration "library" {
    targetType "library"
    targetName "svgraster"
    excludedSourceFiles "source/app.d"
}
