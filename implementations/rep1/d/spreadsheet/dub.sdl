name "spreadsheet"
description "Spreadsheet engine with incremental recalculation, plus a command-line driver"
authors "Peter Alexander"
copyright "Copyright © 2026"
license "MIT"

targetType "executable"
targetName "spreadsheet"
sourcePaths "source"
importPaths "source"
mainSourceFile "source/app.d"

configuration "cli" {
    targetType "executable"
}

# Use this configuration to link only the library (no command-line tool):
#   dub build --config=library
configuration "library" {
    targetType "library"
    excludedSourceFiles "source/app.d"
}
