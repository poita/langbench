{
    "name": "linalg",
    "description": "Dense real linear algebra: LU, QR, Cholesky, Jacobi eigen/SVD, with a Matrix Market command-line driver",
    "license": "MIT",
    "authors": ["linalg contributors"],
    "copyright": "Copyright (c) linalg contributors",
    "targetType": "executable",
    "targetPath": "bin",
    "targetName": "linalg",
    "configurations": [
        {
            "name": "cli",
            "targetType": "executable",
            "mainSourceFile": "source/app.d",
            "sourcePaths": ["source"],
            "importPaths": ["source"]
        },
        {
            "name": "library",
            "targetType": "library",
            "targetName": "linalg",
            "sourcePaths": ["source/linalg"],
            "importPaths": ["source"]
        },
        {
            "name": "unittest",
            "targetType": "executable",
            "targetName": "linalg-test",
            "mainSourceFile": "source/app.d",
            "sourcePaths": ["source/linalg", "tests"],
            "importPaths": ["source"]
        }
    ]
}
