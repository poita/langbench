{
	"name": "canonjson",
	"description": "Strict JSON (RFC 8259) parser and canonical serializer, written from scratch",
	"license": "MIT",
	"copyright": "Copyright © 2026",
	"targetPath": "bin",
	"importPaths": ["source"],
	"configurations": [
		{
			"name": "cli",
			"targetType": "executable",
			"targetName": "canonjson",
			"sourcePaths": ["source", "app"],
			"mainSourceFile": "app/main.d"
		},
		{
			"name": "library",
			"targetType": "library",
			"targetName": "canonjson",
			"sourcePaths": ["source"]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"targetName": "canonjson-test",
			"sourcePaths": ["source", "tests"],
			"mainSourceFile": "tests/main.d"
		}
	]
}
