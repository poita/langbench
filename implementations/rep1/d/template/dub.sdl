name "jinjalite"
description "A small Jinja2-style template engine for D: expressions, filters, loops, macros, include and template inheritance."
authors "jinjalite authors"
copyright "Copyright © jinjalite authors"
license "MIT"

sourcePaths "source"
importPaths "source"

// `dub build` builds the first configuration: the command-line tool.
configuration "application" {
    targetType "executable"
    targetName "jinjalite"
    targetPath "bin"
    sourcePaths "source" "cli"
    mainSourceFile "cli/main.d"
}

// Use this configuration when depending on jinjalite as a library.
configuration "library" {
    targetType "library"
}

// `dub test` picks this configuration: library modules plus the tests/ directory.
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
