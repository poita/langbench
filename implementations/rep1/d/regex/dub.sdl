name "btregex"
description "A small backtracking regular-expression engine with Perl-style leftmost-first semantics and capture positions"
authors "btregex contributors"
copyright "Copyright © 2026, btregex contributors"
license "MIT"
targetType "library"

configuration "library" {
    targetType "library"
    targetName "btregex"
    sourcePaths "source"
}

configuration "cli" {
    targetType "executable"
    targetName "btregex"
    targetPath "bin"
    sourcePaths "source" "app"
    mainSourceFile "app/main.d"
}
