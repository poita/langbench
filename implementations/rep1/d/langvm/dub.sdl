name "langvm"
description "A compiler and stack virtual machine for the Vellum language"
authors "langvm contributors"
copyright "Copyright © langvm contributors"
license "MIT"

# The default configuration builds the command-line tool (bin/langvm).
configuration "executable" {
    targetType "executable"
    targetName "langvm"
    targetPath "bin"
    mainSourceFile "source/app.d"
}

# Use this configuration to depend on langvm as a library.
configuration "library" {
    targetType "library"
    targetName "langvm"
    excludedSourceFiles "source/app.d"
}

# `dub test` builds this configuration: the library plus the tests under tests/.
configuration "unittest" {
    targetType "library"
    targetName "langvm-test"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
    excludedSourceFiles "source/app.d"
}
