name "fulltext"
description "Positional full-text search library: Porter stemming, boolean/phrase queries, BM25 ranking and snippets"
authors "fulltext contributors"
license "MIT"
copyright "Copyright © 2026, fulltext contributors"

targetType "library"
sourcePaths "source"
importPaths "source"
excludedSourceFiles "app/*"

configuration "cli" {
    targetType "executable"
    targetName "fulltext"
    sourcePaths "source" "app"
    mainSourceFile "app/main.d"
}

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    targetType "library"
    sourcePaths "source"
    stringImportPaths "tests/data"
}
