{
    "name": "fulltext",
    "description": "A small full-text search engine: positional inverted index, Porter stemming, boolean/phrase queries, BM25 ranking and snippets.",
    "license": "MIT",
    "copyright": "Copyright © 2026",
    "authors": ["fulltext contributors"],
    "targetType": "executable",
    "configurations": [
        {
            "name": "application",
            "targetType": "executable",
            "targetName": "fulltext",
            "targetPath": "bin",
            "mainSourceFile": "app/main.d",
            "sourcePaths": ["src", "app"],
            "importPaths": ["src"]
        },
        {
            "name": "library",
            "targetType": "library",
            "targetName": "fulltext",
            "sourcePaths": ["src"],
            "importPaths": ["src"]
        },
        {
            "name": "unittest",
            "targetType": "library",
            "targetName": "fulltext-test",
            "sourcePaths": ["src", "tests"],
            "importPaths": ["src"],
            "stringImportPaths": ["tests/data"]
        }
    ]
}
