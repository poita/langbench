{
	"name": "toml",
	"description": "A TOML 1.0.0 parser and serializer with a tagged-JSON command-line tool",
	"license": "MIT",
	"authors": ["toml contributors"],
	"copyright": "Copyright © 2026",
	"targetPath": "bin",
	"configurations": [
		{
			"name": "cli",
			"targetType": "executable",
			"targetName": "toml-cli",
			"sourcePaths": ["source", "app"],
			"importPaths": ["source"],
			"mainSourceFile": "app/main.d"
		},
		{
			"name": "library",
			"targetType": "library",
			"targetName": "toml",
			"sourcePaths": ["source"],
			"importPaths": ["source"]
		},
		{
			"name": "unittest",
			"targetType": "library",
			"targetName": "toml-test",
			"sourcePaths": ["source", "tests"],
			"importPaths": ["source", "tests"]
		}
	]
}
