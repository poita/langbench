name "orderbook"
description "Single-instrument limit order book matching engine with price-time priority"
authors "Peter Alexander"
copyright "Copyright © 2026"
license "MIT"

# The first configuration is the one `dub build` uses; dependants that do not
# pick a configuration get the first *library* configuration ("library").
configuration "cli" {
    targetType "executable"
    targetName "orderbook"
    targetPath "bin"
    sourcePaths "source" "app"
    importPaths "source"
    mainSourceFile "app/main.d"
}

configuration "library" {
    targetType "library"
    sourcePaths "source"
    importPaths "source"
}

# Used by `dub test`: library sources plus the test modules in tests/.
configuration "unittest" {
    targetType "autodetect"
    sourcePaths "source" "tests"
    importPaths "source"
}
