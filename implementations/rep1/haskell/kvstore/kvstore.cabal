cabal-version:      3.0
name:               kvstore
version:            0.1.0.0
synopsis:           Tessera, an embedded transactional document store with a write-ahead log
description:
  Tessera is a single-file document store: a page-based B+tree primary index,
  overflow pages for large values, secondary indexes on document fields, a
  write-ahead log with crash recovery and checkpointing, and a small command
  language.  Every byte of the database file and the log is deterministic.
license:            NONE
author:             kvstore authors
maintainer:         peter.alexander.au@gmail.com
category:           Database
build-type:         Simple
tested-with:        GHC == 9.14.1
extra-doc-files:    README.md

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Wno-name-shadowing

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Tessera
    Tessera.Binary
    Tessera.Command
    Tessera.Constants
    Tessera.CRC
    Tessera.Error
    Tessera.Exec
    Tessera.Index
    Tessera.IndexKey
    Tessera.Lexer
    Tessera.Overflow
    Tessera.Page
    Tessera.Pager
    Tessera.Parser
    Tessera.Path
    Tessera.Query
    Tessera.Render
    Tessera.Script
    Tessera.Store
    Tessera.BTree
    Tessera.Value
    Tessera.WAL
  build-depends:
    base       >= 4.18 && < 5,
    array      >= 0.5 && < 0.6,
    bytestring >= 0.11 && < 0.13,
    containers >= 0.6 && < 0.9

executable kvstore
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    base,
    bytestring,
    directory >= 1.3 && < 1.4,
    filepath  >= 1.4 && < 1.6,
    kvstore

test-suite kvstore-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  ghc-options:      -Wno-orphans -Wno-incomplete-uni-patterns -Wno-deprecations
  main-is:          Spec.hs
  other-modules:
    CRCSpec
    ValueSpec
    ParserSpec
    BTreeSpec
    StoreSpec
    ScriptSpec
    RecoverySpec
    Helpers
    Examples
  build-depends:
    base,
    bytestring,
    containers,
    hspec      >= 2.10,
    QuickCheck >= 2.14,
    kvstore
