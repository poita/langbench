cabal-version:      3.0
name:               hjq
version:            0.1.0.0
synopsis:           A small jq-subset query language: parser, evaluator and CLI
description:
  hjq implements a subset of the jq filter language (semantics of jq 1.7).
  It ships a hand-written JSON parser and serializer, a filter parser,
  a lazy tree-walking evaluator, and a command-line tool.
license:            MIT
author:             hjq contributors
maintainer:         peter.alexander.au@gmail.com
category:           Text, JSON
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Jq
    Jq.Value
    Jq.Number
    Jq.Json.Parse
    Jq.Json.Render
    Jq.Syntax
    Jq.Lexer
    Jq.Parser
    Jq.Stream
    Jq.Ops
    Jq.Eval
  build-depends:
    base       >=4.14 && <5,
    bytestring >=0.10,
    containers >=0.6,
    text       >=1.2

executable hjq
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    base,
    bytestring,
    text,
    hjq

test-suite hjq-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:
    base,
    bytestring,
    containers,
    text,
    hjq,
    hspec,
    QuickCheck
