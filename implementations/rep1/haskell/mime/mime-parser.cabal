cabal-version:      3.0
name:               mime-parser
version:            0.1.0.0
synopsis:           A hand-written MIME email parser and mailbox dumper
description:
  Parses mbox archives and directories of @.eml@ files as RFC 5322 /
  RFC 2045-2047 / RFC 2231 messages, without relying on any email, MIME,
  header, date or transfer-encoding library, and renders a normalised text
  dump of every message plus the decoded bytes of every attachment.
license:            MIT
license-file:       LICENSE
author:             mime-parser contributors
maintainer:         peter.alexander.au@gmail.com
category:           Text, Email
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: GHC2021
  ghc-options:      -Wall

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Mime
    Mime.Address
    Mime.Bytes
    Mime.Charset
    Mime.Date
    Mime.EncodedWord
    Mime.Header
    Mime.Lexical
    Mime.Mailbox
    Mime.Message
    Mime.Params
    Mime.Part
    Mime.Render
    Mime.Transfer
  build-depends:
    base >=4 && <5,
    bytestring,
    containers,
    directory,
    filepath

executable mime-dump
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    base >=4 && <5,
    mime-parser

test-suite mime-parser-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:
    base >=4 && <5,
    bytestring,
    directory,
    filepath,
    hspec,
    QuickCheck,
    mime-parser
