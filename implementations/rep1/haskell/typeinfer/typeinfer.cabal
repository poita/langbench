cabal-version:      3.0
name:               typeinfer
version:            0.1.0.0
synopsis:           Hindley-Milner type inference for a small ML-like language
description:
  A reusable library (and command-line tool) that parses a small ML-like
  language and infers the principal type of each top-level declaration using
  Algorithm J: union-find unification over shared type graphs, level-based
  generalisation and let-polymorphism without a value restriction.
category:           Language
license:            MIT
author:             typeinfer contributors
maintainer:         typeinfer contributors
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language:   GHC2021
  default-extensions: LambdaCase
  ghc-options:        -Wall

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Language.TypeInfer
    Language.TypeInfer.Builtins
    Language.TypeInfer.Error
    Language.TypeInfer.Graph
    Language.TypeInfer.Infer
    Language.TypeInfer.Lexer
    Language.TypeInfer.Parser
    Language.TypeInfer.Syntax
    Language.TypeInfer.Type
    Language.TypeInfer.Unify
  build-depends:
    , array         >=0.5  && <0.6
    , base          >=4.18 && <5
    , containers    >=0.6  && <0.9
    , transformers  >=0.6  && <0.7

executable typeinfer
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base
    , typeinfer

test-suite typeinfer-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    Generators
    InferSpec
    ParserSpec
    TypeSpec
  build-depends:
    , base
    , hspec       >=2.10
    , QuickCheck  >=2.14
    , typeinfer
