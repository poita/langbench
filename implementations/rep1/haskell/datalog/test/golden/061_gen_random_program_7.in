d10(Y, a, Y) :- b2(W, _, W), b1(_, Z, Y), b2(_, X, Z).
d10(W, Z, Z) :- b2(Z, 0, Y), not b1(Z, c, a), b0(W, Z), b1(W, Y, W).
d11(Z) :- b1(_, _, _), W <= Z, not b2(W, W, W), b0(W, Z).
d11(W) :- d10(W, Y, X).
d11(W) :- W = Z, b0(Z, W).
d20(Y, Y) :- d11(Z), d10(Y, Z, Y), Z < Y.
d20(W, X) :- b2(_, W, X), not d10(W, X, b), X <= W.
d21(1, b, 3) :- b0(3, 1).
d21(X, Z, b) :- d20(X, X), d11(Z).
d30(3) :- d10(Y, Y, Z), b1(Y, X, X), d10(Y, X, W).
d30(Y) :- d10(Y, Z, Y), d11(X), d11(Z), not b1(Y, Y, a), X > Y.
d30(W) :- b0(0, _), d11(Y), b2(W, W, _).
d31(W) :- b1(W, X, Y), not b0(2, W), X != Y, d20(Y, -1), b1(X, X, W).
d31(Y) :- d11(Y), d11(X).
?- b0(X, Y).
?- b1(X, Y, Z).
?- b1(c, c, c).
?- b2(X, Y, Z).
?- b2(X, X, 0).
?- d10(X, Y, Z).
?- d10(_, X, 3).
?- d11(X).
