d10(X, X) :- b2(_, X), b1(0, -1).
d10(Z, Z) :- b1(Z, Z), Z > a.
d10(Y, Z) :- b1(1, 1), d10(Y, W), d10(Z, W), not b1(W, 3), Y < 3.
d11(Z, Z) :- b2(X, Z), d10(W, _), d11(b, X), not b1(1, W), X < a.
d11(Y, Y) :- b1(_, Y), not b1(Y, Y), Y <= 1.
d20(W) :- d11(W, 2).
d20(X) :- b0(X), d10(_, X), not d11(X, X), X < b.
d20(Z) :- Z <= W, not d11(Z, Z), b2(Z, Z), b0(Z), b2(W, _).
d21(X, Z, X) :- b1(Z, X), X < Z, d11(2, 2).
d21(Z, Z, Z) :- b2(Z, _), not d11(-1, Z), Z >= -1.
d30(W, X, W) :- d20(_), d21(X, a, Y), d11(W, _), not d10(Y, Y).
d30(-1, Y, Y) :- Y < b, d11(Y, 0), b2(_, Y), d20(_).
d30(X, X, b) :- b0(X), b2(X, Y).
d31(Z, X, X) :- b2(W, X), b1(Z, X).
d31(-1, W, W) :- W < Y, d11(W, Y).
d31(Z, Z, Z) :- b2(Z, Z), not d10(Z, Z), Z != 0.
?- b0(X).
?- b0(X).
?- b2(X, Y).
?- d10(X, Y).
?- d10(2, -1).
?- d11(X, Y).
?- d20(X).
?- d21(X, Y, Z).
?- d30(X, Y, Z).
?- d30(X, X, X).
?- d31(X, Y, Z).
