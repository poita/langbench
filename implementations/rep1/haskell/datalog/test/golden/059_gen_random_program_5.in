d10(0, W) :- d11(W, _), d10(W, Y), Y >= W.
d10(Z, Z) :- b0(3, Z, a), b1(Z, Z), b1(Z, X).
d11(W, Y) :- b1(Y, W), b2(_), Y > W.
d11(X, X) :- b1(Y, X), b2(X).
d11(Z, Z) :- d11(2, Z), b2(X).
d20(b, X, Y) :- d11(Z, Y), b1(X, X), not b2(Z).
d20(Z, X, X) :- b1(Z, Z), b2(Z), d10(c, X).
d20(b, X, c) :- d11(X, 1), d20(Y, 3, X), b2(X).
d21(W, c) :- d10(W, Y), d10(Y, X), not b1(W, Y).
d21(X, X) :- d11(X, Y).
d30(Z) :- d21(Z, 0), b1(0, W), d20(Y, Y, Z).
d30(Z) :- Z <= a, b2(Z).
d31(W) :- d20(_, W, 1), W <= 0.
d31(W) :- d10(Z, W), not d21(Z, b).
d31(W) :- b2(b), b0(2, W, W), W = 0, d21(W, W).
?- b1(X, Y).
?- b1(-1, X).
?- d10(X, Y).
?- d11(X, Y).
?- d11(X, 2).
?- d20(X, Y, Z).
?- d21(X, Y).
