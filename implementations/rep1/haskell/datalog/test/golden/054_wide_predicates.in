t(1, 2, 3, 4, 5, 6). t(1, 2, 3, 4, 5, 7). t(0, 2, 3, 4, 5, 6). t(1, 1, 1, 1, 1, 1). t(a, b, c, d, e, f).
u(A, B, C, D, E, F) :- t(A, B, C, D, E, F), A = 1.
v(F, E, D, C, B, A) :- t(A, B, C, D, E, F).
w(X, Y) :- t(X, _, _, _, _, Y), t(Y, _, _, _, _, _).
?- t(1, _, _, _, _, X).
?- u(A, B, C, D, E, F).
?- v(A, B, C, D, E, F).
?- w(X, Y).
?- t(_, _, _, _, _, _).
?- t(X, X, X, X, X, X).
