cabal-version:      3.0
name:               chess-perft
version:            0.1.0.0
synopsis:           Legal chess move generator with perft and divide
description:
  A bitboard-based legal move generator for standard chess, together with
  @perft@ and @divide@ counting. The library exposes the board, position,
  move-generation and search layers separately; the @chess-perft@ executable
  answers line-oriented perft/divide queries read from standard input.
category:           Game
license:            MIT
license-file:       LICENSE
author:             chess-perft contributors
maintainer:         peter.alexander.au@gmail.com
build-type:         Simple
extra-doc-files:    README.md
tested-with:        GHC == 9.14.1

common shared
  default-language: GHC2021
  ghc-options:      -Wall

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Chess.Perft
    Chess.Perft.Types
    Chess.Perft.Bitboard
    Chess.Perft.Position
    Chess.Perft.MoveGen
    Chess.Perft.Search
    Chess.Perft.Query
  build-depends:
    base  >=4.18 && <5,
    array >=0.5  && <0.6

executable chess-perft
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    base >=4.18 && <5,
    chess-perft

test-suite chess-perft-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    PositionSpec
    MoveGenSpec
    PerftSpec
    QuerySpec
  build-depends:
    base >=4.18 && <5,
    chess-perft,
    hspec      >=2.10,
    QuickCheck >=2.14
