cabal-version:      3.0
name:               depresolve
version:            0.1.0.0
synopsis:           Deterministic package dependency resolver
description:
  A dependency resolver for semver-style package registries. It reproduces a
  fully specified depth-first, newest-first, chronologically backtracking
  search, so every run yields the same first solution.
license:            MIT
author:             depresolve contributors
maintainer:         peter.alexander.au@gmail.com
category:           Package Management
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Depresolve
    Depresolve.Version
    Depresolve.Range
    Depresolve.Registry
    Depresolve.Parse
    Depresolve.Resolve
  build-depends:
    , base        >=4.18 && <5
    , array
    , bytestring
    , containers

executable depresolve
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base
    , bytestring
    , depresolve

test-suite depresolve-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:    Reference
  build-depends:
    , base
    , bytestring
    , containers
    , depresolve
    , hspec
    , QuickCheck
