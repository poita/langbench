{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}

 :aliases
 {;; clojure -M:run < input.txt
  :run {:main-opts ["-m" "chip8.main"]}

  ;; clojure -M:test   (Cognitect test-runner; extra args are passed through)
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clojure -M:compile  -- AOT-compile the CLI into target/classes
  :compile {:extra-paths ["target/classes"]
            :main-opts ["-e" "(binding [*compile-path* \"target/classes\"] (compile 'chip8.main))"]}}}
