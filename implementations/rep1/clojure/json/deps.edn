{:paths ["src"]

 :aliases
 {;; Ahead-of-time compiled classes produced by build.sh; used by run.sh.
  :aot   {:extra-paths ["classes"]}

  ;; Compiles the CLI (and, transitively, the library) into classes/.
  :build {:extra-paths ["classes"]
          :jvm-opts    ["-Dclojure.compiler.direct-linking=true"]
          :main-opts   ["-e" "(compile 'json.cli)"]}

  ;; Test suite: `clojure -M:test`
  :test  {:extra-paths ["test"]
          :extra-deps  {org.clojure/test.check
                        {:mvn/version "1.1.1"}
                        io.github.cognitect-labs/test-runner
                        {:git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
          :main-opts   ["-m" "cognitect.test-runner"]
          :exec-fn     cognitect.test-runner.api/test}}}
