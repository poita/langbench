{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}

 :aliases
 {;; clojure -M:cli < input.txt
  :cli {:main-opts ["-m" "orderbook.cli"]}

  ;; AOT-compiled classes (see build.sh)
  :aot {:extra-paths ["target/classes"]}

  ;; clojure -X:test
  :test {:extra-paths ["test" "test-resources"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                       io.github.cognitect-labs/test-runner
                       {:git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}}}
