{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}

 :aliases
 {;; clojure -M:test            run the unit and property tests
  :test
  {:extra-paths ["test"]
   :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                 io.github.cognitect-labs/test-runner
                 {:git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts   ["-m" "cognitect.test-runner"]}

  ;; clojure -M:aot             AOT-compile the command-line tool into ./classes
  :aot
  {:extra-paths ["classes"]
   :main-opts   ["-e" "(compile 'template.main)"]}}}
