{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}

 :aliases
 {;; Ahead-of-time compile the CLI into ./classes (see build.sh).
  :build {:extra-paths ["classes"]
          :main-opts ["-e" "(binding [*compile-path* \"classes\"] (compile 'protowire.cli))"]}

  ;; Run the CLI against already-compiled classes (see run.sh).
  :run {:extra-paths ["classes"]
        :main-opts ["-m" "protowire.cli"]}

  ;; clojure -M:test
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
