let all_m15 = glob("src/m15/**/*.txt")
let s_m15 = sort(reject(all_m15, "**/skip_*.txt"))
let o_m15 = []
each i, f in s_m15 {
    when i % 3 == 0 {
        step {
            out "out/m15/{stem(f)}.txt"
            in f
            cmd replace("a", "A")
            cost 3
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m15/{stem(f)}.txt"
            in f
            cmd dedup()
            cost 3
        }
    } otherwise {
        step {
            out "out/m15/{stem(f)}.txt"
            in f
            cmd upper()
            cost 2
        }
    }
    set o_m15 = o_m15 ++ ["out/m15/{stem(f)}.txt"]
}
step {
    out "out/m15/bundle.txt"
    in o_m15
    cmd count_lines()
    cost 2
}
use wrapper("m15/wrapped", "out/m15/bundle.txt", "<m15|", "|>\n", 3)
phony m15 = ["out/m15/wrapped.txt"]
