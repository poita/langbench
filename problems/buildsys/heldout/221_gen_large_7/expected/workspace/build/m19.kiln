let all_m19 = glob("src/m19/**/*.txt")
let s_m19 = sort(reject(all_m19, "**/skip_*.txt"))
let o_m19 = []
each i, f in s_m19 {
    when i % 3 == 0 {
        step {
            out "out/m19/{stem(f)}.txt"
            in f
            cmd reverse_lines()
            cost 2
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m19/{stem(f)}.txt"
            in f
            cmd reverse_lines()
            cost 2
        }
    } otherwise {
        step {
            out "out/m19/{stem(f)}.txt"
            in f
            cmd upper()
            cost 2
        }
    }
    set o_m19 = o_m19 ++ ["out/m19/{stem(f)}.txt"]
}
step {
    out "out/m19/bundle.txt"
    in o_m19
    cmd hash()
    cost 3
}
use wrapper("m19/wrapped", "out/m19/bundle.txt", "<m19|", "|>\n", 0)
phony m19 = ["out/m19/wrapped.txt"]
