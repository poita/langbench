rule wrapper(name, src, pre, post, w) {
    step {
        out "out/{name}.txt"
        in src
        cmd wrap(pre, post)
        cost w
    }
}
include "build/m0.kiln"
include "build/m1.kiln"
include "build/m2.kiln"
include "build/m3.kiln"
include "build/m4.kiln"
include "build/m5.kiln"
include "build/m6.kiln"
include "build/m7.kiln"
include "build/m8.kiln"
include "build/m9.kiln"
include "build/m10.kiln"
include "build/m11.kiln"
include "build/m12.kiln"
include "build/m13.kiln"
include "build/m14.kiln"
include "build/m15.kiln"
include "build/m16.kiln"
include "build/m17.kiln"
include "build/m18.kiln"
include "build/m19.kiln"
include "build/m20.kiln"
include "build/m21.kiln"
include "build/m22.kiln"
step {
    out "out/all.txt"
    in ["out/m0/bundle.txt", "out/m1/bundle.txt", "out/m2/bundle.txt", "out/m3/bundle.txt", "out/m4/bundle.txt", "out/m5/bundle.txt", "out/m6/bundle.txt", "out/m7/bundle.txt", "out/m8/bundle.txt", "out/m9/bundle.txt", "out/m10/bundle.txt", "out/m11/bundle.txt", "out/m12/bundle.txt", "out/m13/bundle.txt", "out/m14/bundle.txt", "out/m15/bundle.txt", "out/m16/bundle.txt", "out/m17/bundle.txt", "out/m18/bundle.txt", "out/m19/bundle.txt", "out/m20/bundle.txt", "out/m21/bundle.txt", "out/m22/bundle.txt"]
    after ["@m0", "@m1", "@m2", "@m3", "@m4", "@m5", "@m6", "@m7", "@m8", "@m9", "@m10", "@m11", "@m12", "@m13", "@m14", "@m15", "@m16", "@m17", "@m18", "@m19", "@m20", "@m21", "@m22"]
    cmd count_lines()
    cost 3
}
phony all = ["out/all.txt", "@m0", "@m1", "@m2", "@m3", "@m4", "@m5", "@m6", "@m7", "@m8", "@m9", "@m10", "@m11", "@m12", "@m13", "@m14", "@m15", "@m16", "@m17", "@m18", "@m19", "@m20", "@m21", "@m22"]
default "@all"
