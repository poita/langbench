let all_m21 = glob("src/m21/**/*.txt")
let s_m21 = sort(reject(all_m21, "**/skip_*.txt"))
let o_m21 = []
each i, f in s_m21 {
    when i % 3 == 0 {
        step {
            out "out/m21/{stem(f)}.txt"
            in f
            cmd upper()
            cost 2
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m21/{stem(f)}.txt"
            in f
            cmd sort_lines()
            cost 4
        }
    } otherwise {
        step {
            out "out/m21/{stem(f)}.txt"
            in f
            cmd grep("e")
            cost 3
        }
    }
    set o_m21 = o_m21 ++ ["out/m21/{stem(f)}.txt"]
}
step {
    out "out/m21/bundle.txt"
    in o_m21
    cmd hash()
    cost 3
}
use wrapper("m21/wrapped", "out/m21/bundle.txt", "<m21|", "|>\n", 3)
phony m21 = ["out/m21/wrapped.txt"]
