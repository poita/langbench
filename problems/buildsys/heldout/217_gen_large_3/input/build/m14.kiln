let all_m14 = glob("src/m14/**/*.txt")
let s_m14 = sort(reject(all_m14, "**/skip_*.txt"))
let o_m14 = []
each i, f in s_m14 {
    when i % 3 == 0 {
        step {
            out "out/m14/{stem(f)}.txt"
            in f
            cmd copy()
            cost 1
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m14/{stem(f)}.txt"
            in f
            cmd wrap("[", "]\n")
            cost 1
        }
    } otherwise {
        step {
            out "out/m14/{stem(f)}.txt"
            in f
            cmd wrap("[", "]\n")
            cost 1
        }
    }
    set o_m14 = o_m14 ++ ["out/m14/{stem(f)}.txt"]
}
step {
    out "out/m14/bundle.txt"
    in o_m14
    cmd hash()
    cost 3
}
use wrapper("m14/wrapped", "out/m14/bundle.txt", "<m14|", "|>\n", 3)
phony m14 = ["out/m14/wrapped.txt"]
