rule wrapper(name, src, pre, post, w) {
    step {
        out "out/{name}.txt"
        in src
        cmd wrap(pre, post)
        cost w
    }
}
include "build/m0.kiln"
include "build/m1.kiln"
include "build/m2.kiln"
include "build/m3.kiln"
include "build/m4.kiln"
step {
    out "out/all.txt"
    in ["out/m0/bundle.txt", "out/m1/bundle.txt", "out/m2/bundle.txt", "out/m3/bundle.txt", "out/m4/bundle.txt"]
    after ["@m0", "@m1", "@m2", "@m3", "@m4"]
    cmd count_lines()
    cost 3
}
phony all = ["out/all.txt", "@m0", "@m1", "@m2", "@m3", "@m4"]
default "@all"
step {
    out "out/noise.txt"
    cmd write("{count(glob("noise/**"))}:{count(glob("noise/**/n1*.dat"))}:{count(glob("**"))}\n")
}
default "out/noise.txt"
