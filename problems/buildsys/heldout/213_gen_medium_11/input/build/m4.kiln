let all_m4 = glob("src/m4/**/*.txt")
let s_m4 = sort(reject(all_m4, "**/skip_*.txt"))
let o_m4 = []
each i, f in s_m4 {
    when i % 3 == 0 {
        step {
            out "out/m4/{stem(f)}.txt"
            in f
            cmd grep("e")
            cost 3
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m4/{stem(f)}.txt"
            in f
            cmd replace("a", "A")
            cost 3
        }
    } otherwise {
        step {
            out "out/m4/{stem(f)}.txt"
            in f
            cmd wrap("[", "]\n")
            cost 1
        }
    }
    set o_m4 = o_m4 ++ ["out/m4/{stem(f)}.txt"]
}
step {
    out "out/m4/bundle.txt"
    in o_m4
    cmd concat()
    cost 4
}
use wrapper("m4/wrapped", "out/m4/bundle.txt", "<m4|", "|>\n", 3)
phony m4 = ["out/m4/wrapped.txt"]
