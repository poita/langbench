let all_m9 = glob("src/m9/**/*.txt")
let s_m9 = sort(reject(all_m9, "**/skip_*.txt"))
let o_m9 = []
each i, f in s_m9 {
    when i % 3 == 0 {
        step {
            out "out/m9/{stem(f)}.txt"
            in f
            cmd replace("a", "A")
            cost 3
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m9/{stem(f)}.txt"
            in f
            cmd dedup()
            cost 3
        }
    } otherwise {
        step {
            out "out/m9/{stem(f)}.txt"
            in f
            cmd indent(2)
            cost 2
        }
    }
    set o_m9 = o_m9 ++ ["out/m9/{stem(f)}.txt"]
}
step {
    out "out/m9/bundle.txt"
    in o_m9
    cmd concat()
    cost 4
}
use wrapper("m9/wrapped", "out/m9/bundle.txt", "<m9|", "|>\n", 0)
phony m9 = ["out/m9/wrapped.txt"]
