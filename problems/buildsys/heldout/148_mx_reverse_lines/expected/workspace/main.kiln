step {
    out "out/reverse_lines_0.txt"
    in "src/e.txt"
    cmd reverse_lines()
}
step {
    out "out/reverse_lines_1.txt"
    in "src/n.txt"
    cmd reverse_lines()
}
step {
    out "out/reverse_lines_2.txt"
    in "src/x.txt"
    cmd reverse_lines()
}
step {
    out "out/reverse_lines_3.txt"
    in "src/c.txt"
    cmd reverse_lines()
}
step {
    out "out/reverse_lines_4.txt"
    in "src/u.txt"
    cmd reverse_lines()
}
step {
    out "out/reverse_lines_5.txt"
    in "src/b.txt"
    cmd reverse_lines()
}
step {
    out "out/reverse_lines_pin.txt"
    in ["out/reverse_lines_0.txt", "out/reverse_lines_1.txt", "out/reverse_lines_2.txt", "out/reverse_lines_3.txt", "out/reverse_lines_4.txt", "out/reverse_lines_5.txt"]
    cmd hash()
}
default "out/reverse_lines_pin.txt"
