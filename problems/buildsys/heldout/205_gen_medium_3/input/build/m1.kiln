let all_m1 = glob("src/m1/**/*.txt")
let s_m1 = sort(reject(all_m1, "**/skip_*.txt"))
let o_m1 = []
each i, f in s_m1 {
    when i % 3 == 0 {
        step {
            out "out/m1/{stem(f)}.txt"
            in f
            cmd wrap("[", "]\n")
            cost 1
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m1/{stem(f)}.txt"
            in f
            cmd wrap("[", "]\n")
            cost 1
        }
    } otherwise {
        step {
            out "out/m1/{stem(f)}.txt"
            in f
            cmd number()
            cost 2
        }
    }
    set o_m1 = o_m1 ++ ["out/m1/{stem(f)}.txt"]
}
step {
    out "out/m1/bundle.txt"
    in o_m1
    cmd count_lines()
    cost 2
}
use wrapper("m1/wrapped", "out/m1/bundle.txt", "<m1|", "|>\n", 0)
phony m1 = ["out/m1/wrapped.txt"]
