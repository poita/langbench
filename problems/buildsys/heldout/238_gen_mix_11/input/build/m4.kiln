let all_m4 = glob("src/m4/**/*.txt")
let s_m4 = sort(reject(all_m4, "**/skip_*.txt"))
let o_m4 = []
each i, f in s_m4 {
    when i % 3 == 0 {
        step {
            out "out/m4/{stem(f)}.txt"
            in f
            cmd dedup()
            cost 3
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m4/{stem(f)}.txt"
            in f
            cmd reverse_lines()
            cost 2
        }
    } otherwise {
        step {
            out "out/m4/{stem(f)}.txt"
            in f
            cmd lower()
            cost 2
        }
    }
    set o_m4 = o_m4 ++ ["out/m4/{stem(f)}.txt"]
}
step {
    out "out/m4/bundle.txt"
    in o_m4
    cmd hash()
    cost 3
}
use wrapper("m4/wrapped", "out/m4/bundle.txt", "<m4|", "|>\n", 0)
phony m4 = ["out/m4/wrapped.txt"]
