step {
    out "out/wrap_0.txt"
    in "src/e.txt"
    cmd wrap("<<", ">>")
}
step {
    out "out/wrap_1.txt"
    in "src/n.txt"
    cmd wrap("<<", ">>")
}
step {
    out "out/wrap_2.txt"
    in "src/x.txt"
    cmd wrap("<<", ">>")
}
step {
    out "out/wrap_3.txt"
    in "src/c.txt"
    cmd wrap("<<", ">>")
}
step {
    out "out/wrap_4.txt"
    in "src/u.txt"
    cmd wrap("<<", ">>")
}
step {
    out "out/wrap_5.txt"
    in "src/b.txt"
    cmd wrap("<<", ">>")
}
step {
    out "out/wrap_pin.txt"
    in ["out/wrap_0.txt", "out/wrap_1.txt", "out/wrap_2.txt", "out/wrap_3.txt", "out/wrap_4.txt", "out/wrap_5.txt"]
    cmd hash()
}
default "out/wrap_pin.txt"
