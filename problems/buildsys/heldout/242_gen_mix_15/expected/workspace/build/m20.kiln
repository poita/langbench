let all_m20 = glob("src/m20/**/*.txt")
let s_m20 = sort(reject(all_m20, "**/skip_*.txt"))
let o_m20 = []
each i, f in s_m20 {
    when i % 3 == 0 {
        step {
            out "out/m20/{stem(f)}.txt"
            in f
            cmd upper()
            cost 2
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m20/{stem(f)}.txt"
            in f
            cmd upper()
            cost 2
        }
    } otherwise {
        step {
            out "out/m20/{stem(f)}.txt"
            in f
            cmd dedup()
            cost 3
        }
    }
    set o_m20 = o_m20 ++ ["out/m20/{stem(f)}.txt"]
}
step {
    out "out/m20/bundle.txt"
    in o_m20
    cmd count_lines()
    cost 2
}
use wrapper("m20/wrapped", "out/m20/bundle.txt", "<m20|", "|>\n", 2)
phony m20 = ["out/m20/wrapped.txt"]
