let all_m19 = glob("src/m19/**/*.txt")
let s_m19 = sort(reject(all_m19, "**/skip_*.txt"))
let o_m19 = []
each i, f in s_m19 {
    when i % 3 == 0 {
        step {
            out "out/m19/{stem(f)}.txt"
            in f
            cmd sort_lines()
            cost 4
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m19/{stem(f)}.txt"
            in f
            cmd sort_lines()
            cost 4
        }
    } otherwise {
        step {
            out "out/m19/{stem(f)}.txt"
            in f
            cmd grep("e")
            cost 3
        }
    }
    set o_m19 = o_m19 ++ ["out/m19/{stem(f)}.txt"]
}
step {
    out "out/m19/bundle.txt"
    in o_m19
    cmd concat()
    cost 4
}
use wrapper("m19/wrapped", "out/m19/bundle.txt", "<m19|", "|>\n", 1)
step {
    out "out/m19/doc.txt"
    depfile "out/m19/doc.d"
    in "src/m19/doc.src"
    cmd preprocess()
    cost 3
}
phony m19 = ["out/m19/wrapped.txt", "out/m19/doc.txt"]
