let all_m18 = glob("src/m18/**/*.txt")
let s_m18 = sort(reject(all_m18, "**/skip_*.txt"))
let o_m18 = []
each i, f in s_m18 {
    when i % 3 == 0 {
        step {
            out "out/m18/{stem(f)}.txt"
            in f
            cmd sort_lines()
            cost 4
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m18/{stem(f)}.txt"
            in f
            cmd replace("a", "A")
            cost 3
        }
    } otherwise {
        step {
            out "out/m18/{stem(f)}.txt"
            in f
            cmd replace("a", "A")
            cost 3
        }
    }
    set o_m18 = o_m18 ++ ["out/m18/{stem(f)}.txt"]
}
step {
    out "out/m18/bundle.txt"
    in o_m18
    cmd concat()
    cost 4
}
use wrapper("m18/wrapped", "out/m18/bundle.txt", "<m18|", "|>\n", 0)
phony m18 = ["out/m18/wrapped.txt"]
