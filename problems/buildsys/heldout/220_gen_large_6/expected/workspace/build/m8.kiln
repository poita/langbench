let all_m8 = glob("src/m8/**/*.txt")
let s_m8 = sort(reject(all_m8, "**/skip_*.txt"))
let o_m8 = []
each i, f in s_m8 {
    when i % 3 == 0 {
        step {
            out "out/m8/{stem(f)}.txt"
            in f
            cmd indent(2)
            cost 2
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m8/{stem(f)}.txt"
            in f
            cmd dedup()
            cost 3
        }
    } otherwise {
        step {
            out "out/m8/{stem(f)}.txt"
            in f
            cmd grep("e")
            cost 3
        }
    }
    set o_m8 = o_m8 ++ ["out/m8/{stem(f)}.txt"]
}
step {
    out "out/m8/bundle.txt"
    in o_m8
    cmd count_lines()
    cost 2
}
use wrapper("m8/wrapped", "out/m8/bundle.txt", "<m8|", "|>\n", 2)
phony m8 = ["out/m8/wrapped.txt"]
