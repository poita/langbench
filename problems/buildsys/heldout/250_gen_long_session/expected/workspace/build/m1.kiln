let all_m1 = glob("src/m1/**/*.txt")
let s_m1 = sort(reject(all_m1, "**/skip_*.txt"))
let o_m1 = []
each i, f in s_m1 {
    when i % 3 == 0 {
        step {
            out "out/m1/{stem(f)}.txt"
            in f
            cmd sort_lines()
            cost 4
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m1/{stem(f)}.txt"
            in f
            cmd lower()
            cost 2
        }
    } otherwise {
        step {
            out "out/m1/{stem(f)}.txt"
            in f
            cmd sort_lines()
            cost 4
        }
    }
    set o_m1 = o_m1 ++ ["out/m1/{stem(f)}.txt"]
}
step {
    out "out/m1/bundle.txt"
    in o_m1
    cmd concat()
    cost 4
}
use wrapper("m1/wrapped", "out/m1/bundle.txt", "<m1|", "|>\n", 4)
step {
    out "out/m1/doc.txt"
    depfile "out/m1/doc.d"
    in "src/m1/doc.src"
    cmd preprocess()
    cost 2
}
phony m1 = ["out/m1/wrapped.txt", "out/m1/doc.txt"]
