rule wrapper(name, src, pre, post, w) {
    step {
        out "out/{name}.txt"
        in src
        cmd wrap(pre, post)
        cost w
    }
}
include "build/m0.kiln"
include "build/m1.kiln"
include "build/m2.kiln"
step {
    out "out/all.txt"
    in ["out/m0/bundle.txt", "out/m1/bundle.txt", "out/m2/bundle.txt"]
    after ["@m0", "@m1", "@m2"]
    cmd count_lines()
    cost 3
}
phony all = ["out/all.txt", "@m0", "@m1", "@m2"]
default "@all"
