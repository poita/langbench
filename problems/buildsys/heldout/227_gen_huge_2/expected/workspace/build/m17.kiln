let all_m17 = glob("src/m17/**/*.txt")
let s_m17 = sort(reject(all_m17, "**/skip_*.txt"))
let o_m17 = []
each i, f in s_m17 {
    when i % 3 == 0 {
        step {
            out "out/m17/{stem(f)}.txt"
            in f
            cmd indent(2)
            cost 2
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m17/{stem(f)}.txt"
            in f
            cmd sort_lines()
            cost 4
        }
    } otherwise {
        step {
            out "out/m17/{stem(f)}.txt"
            in f
            cmd sort_lines()
            cost 4
        }
    }
    set o_m17 = o_m17 ++ ["out/m17/{stem(f)}.txt"]
}
step {
    out "out/m17/bundle.txt"
    in o_m17
    cmd hash()
    cost 3
}
use wrapper("m17/wrapped", "out/m17/bundle.txt", "<m17|", "|>\n", 2)
phony m17 = ["out/m17/wrapped.txt"]
