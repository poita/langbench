let all_m16 = glob("src/m16/**/*.txt")
let s_m16 = sort(reject(all_m16, "**/skip_*.txt"))
let o_m16 = []
each i, f in s_m16 {
    when i % 3 == 0 {
        step {
            out "out/m16/{stem(f)}.txt"
            in f
            cmd sort_lines()
            cost 4
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m16/{stem(f)}.txt"
            in f
            cmd lower()
            cost 2
        }
    } otherwise {
        step {
            out "out/m16/{stem(f)}.txt"
            in f
            cmd reverse_lines()
            cost 2
        }
    }
    set o_m16 = o_m16 ++ ["out/m16/{stem(f)}.txt"]
}
step {
    out "out/m16/bundle.txt"
    in o_m16
    cmd count_lines()
    cost 2
}
use wrapper("m16/wrapped", "out/m16/bundle.txt", "<m16|", "|>\n", 4)
step {
    out "out/m16/doc.txt"
    depfile "out/m16/doc.d"
    in "src/m16/doc.src"
    cmd preprocess()
    cost 6
}
phony m16 = ["out/m16/wrapped.txt", "out/m16/doc.txt"]
