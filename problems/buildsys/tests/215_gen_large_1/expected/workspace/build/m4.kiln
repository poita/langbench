let all_m4 = glob("src/m4/**/*.txt")
let s_m4 = sort(reject(all_m4, "**/skip_*.txt"))
let o_m4 = []
each i, f in s_m4 {
    when i % 3 == 0 {
        step {
            out "out/m4/{stem(f)}.txt"
            in f
            cmd number()
            cost 2
        }
    } elsewhen i % 3 == 1 {
        step {
            out "out/m4/{stem(f)}.txt"
            in f
            cmd wrap("[", "]\n")
            cost 1
        }
    } otherwise {
        step {
            out "out/m4/{stem(f)}.txt"
            in f
            cmd replace("a", "A")
            cost 3
        }
    }
    set o_m4 = o_m4 ++ ["out/m4/{stem(f)}.txt"]
}
step {
    out "out/m4/bundle.txt"
    in o_m4
    cmd count_lines()
    cost 2
}
use wrapper("m4/wrapped", "out/m4/bundle.txt", "<m4|", "|>\n", 4)
step {
    out "out/m4/doc.txt"
    depfile "out/m4/doc.d"
    in "src/m4/doc.src"
    cmd preprocess()
    cost 7
}
phony m4 = ["out/m4/wrapped.txt", "out/m4/doc.txt"]
