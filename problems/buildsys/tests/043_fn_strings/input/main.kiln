let s = "Hello, World"
step {
    out "out/l0.txt"
    cmd write("{len(s)} {upper(s)} {lower(s)} {len("")}\n")
}
default "out/l0.txt"
step {
    out "out/l1.txt"
    cmd write("[{trim("  x y  ")}] [{trim("\t\n\r x \r\n\t")}] [{trim("")}] [{trim("  ")}]\n")
}
default "out/l1.txt"
step {
    out "out/l2.txt"
    cmd write("{replace(s, "l", "L")} {replace("aaa", "aa", "b")} {replace("abc", "abc", "")}\n")
}
default "out/l2.txt"
step {
    out "out/l3.txt"
    cmd write("{starts_with(s, "He")} {starts_with(s, "")} {starts_with("a", "ab")} {ends_with(s, "ld")} {ends_with(s, "")} {contains(s, "o, W")} {contains(s, "")} {contains(s, "zz")}\n")
}
default "out/l3.txt"
step {
    out "out/l4.txt"
    cmd write("{substr(s, 1, 3)}|{substr(s, -2, 5)}|{substr(s, 10, 2)}|{substr(s, 2, -1)}|{substr(s, 0, 100)}|{substr(s, -100, 2)}|{substr(s, 12, 1)}\n")
}
default "out/l4.txt"
