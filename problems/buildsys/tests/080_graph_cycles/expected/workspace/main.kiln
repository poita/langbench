step {
    out "out/a.txt"
    in ["src/a.txt", "out/b.txt"]
    cmd concat()
}
step {
    out "out/b.txt"
    in ["src/b.txt", "out/c.txt"]
    cmd concat()
}
step {
    out "out/c.txt"
    in ["src/a.txt", "out/a.txt"]
    cmd concat()
}
phony all = ["out/a.txt", "out/b.txt", "out/c.txt"]
default "@all"
