(define (f x)
  (define y (* x 2))
  (define (g z) (+ y z))
  (g 1))
(f 5)
(define (even-odd n)
  (define (ev? n) (if (= n 0) #t (od? (- n 1))))
  (define (od? n) (if (= n 0) #f (ev? (- n 1))))
  (list (ev? n) (od? n)))
(even-odd 11)
(define (outer)
  (define v 'inner)
  v)
(define v 'global)
(outer)
v
(define (mk)
  (define count 0)
  (lambda () (set! count (+ count 1)) count))
(define k (mk))
(k) (k)
(define (nested)
  (define (a) (b))
  (define (b) 'b-result)
  (a))
(nested)
(define (redefine-in-body x)
  (define x 99)
  x)
(redefine-in-body 1)
(define (uses-later)
  (define result (helper 3))
  result)
(define (helper n) (* n n))
(uses-later)
(let ((q 1))
  (define r (+ q 1))
  (define q 10)
  (list q r))
(define (with-begin)
  (begin (define bb 5))
  bb)
(with-begin)
(define (conditional-define flag)
  (if flag (define cd 'yes) (define cd 'no))
  cd)
(conditional-define #t)
(conditional-define #f)
(define (counter-pair)
  (define n 0)
  (define (inc) (set! n (+ n 1)) n)
  (define (get) n)
  (list inc get))
(define cp (counter-pair))
((car cp)) ((car cp)) ((car (cdr cp)))
