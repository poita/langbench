(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))
(fact 0)
(fact 1)
(fact 5)
(fact 20)
(fact 30)
(fact 50)
(fact 100)
(define (fact-iter n) (let loop ((i n) (acc 1)) (if (= i 0) acc (loop (- i 1) (* acc i)))))
(fact-iter 100)
(= (fact 100) (fact-iter 100))
(string-length (number->string (fact 100)))
