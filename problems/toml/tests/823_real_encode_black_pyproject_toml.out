[build-system]
build-backend = "hatchling.build"
requires = ["hatch-fancy-pypi-readme", "hatch-vcs>=0.3.0", "hatchling>=1.27.0"]

[dependency-groups]
cibw = ["cibuildwheel==4.1.0", "pypyp"]
cov-tests = [{include-group = "coverage"}, {include-group = "tests"}, "pytest-cov>=4.1.0"]
coverage = ["coverage>=5.3"]
dev = [{include-group = "cov-tests"}, {include-group = "tox"}, "pre-commit"]
diff-shades = ["diff-shades @ https://github.com/ichard26/diff-shades/archive/stable.zip"]
diff-shades-comment = ["click>=8.1.7", "packaging>=22.0", "urllib3"]
docs = ["docutils==0.22.4", "furo==2025.12.19", "myst-parser==5.1.0", "sphinx-copybutton==0.5.2", "sphinx==9.1.0", "sphinxcontrib-programoutput==0.20"]
fuzz = [{include-group = "coverage"}, "hypothesis", "hypothesmith"]
hatch = ["hatch==1.15.1", "hatch-fancy-pypi-readme", "hatch-vcs", "virtualenv<21.0.0"]
pyinstaller = ["pyinstaller"]
tests = ["pytest>=7", "pytest-xdist>=3.0.2"]
tox = ["tox>=4.22"]
width-table = ["wcwidth==0.2.14"]

[project]
classifiers = ["Development Status :: 5 - Production/Stable", "Environment :: Console", "Intended Audience :: Developers", "Operating System :: OS Independent", "Programming Language :: Python", "Programming Language :: Python :: 3 :: Only", "Programming Language :: Python :: 3.10", "Programming Language :: Python :: 3.11", "Programming Language :: Python :: 3.12", "Programming Language :: Python :: 3.13", "Programming Language :: Python :: 3.14", "Programming Language :: Python :: 3.15", "Topic :: Software Development :: Libraries :: Python Modules", "Topic :: Software Development :: Quality Assurance"]
dependencies = ["click>=8.0.0", "mypy-extensions>=0.4.3", "packaging>=22.0", "pathspec>=1.0.0", "platformdirs>=2", "pytokens~=0.4.0", "tomli>=1.1.0; python_version<'3.11'", "typing-extensions>=4.0.1; python_version<'3.11'"]
description = "The uncompromising code formatter."
dynamic = ["readme", "version"]
keywords = ["automation", "autopep8", "formatter", "gofmt", "pyfmt", "rustfmt", "yapf"]
license = "MIT"
license-files = ["LICENSE"]
name = "black"
requires-python = ">=3.10"

[[project.authors]]
email = "lukasz@langa.pl"
name = "Łukasz Langa"

[project.entry-points]

[project.entry-points."validate_pyproject.tool_schema"]
black = "black.schema:get_schema"

[project.optional-dependencies]
colorama = ["colorama>=0.4.3"]
d = ["aiohttp>=3.10"]
jupyter = ["ipython>=7.8.0", "tokenize-rt>=3.2.0"]
uvloop = ["uvloop>=0.15.2; sys_platform != 'win32'", "winloop>=0.5.0; sys_platform == 'win32'"]

[project.scripts]
black = "black:patched_main"
blackd = "blackd:patched_main [d]"

[project.urls]
Changelog = "https://github.com/psf/black/blob/main/CHANGES.md"
Documentation = "https://black.readthedocs.io/"
Issues = "https://github.com/psf/black/issues"
Repository = "https://github.com/psf/black"

[tool]

[tool.black]
extend-exclude = "/(\n    # The following are specific to Black, you probably don't want those.\n    tests/data/\n    | profiling/\n)\n"
include = "\\.pyi?$"
line-length = 88
target-version = ["py310"]
unstable = true

[tool.cibuildwheel]
build = "cp31*"
build-verbosity = 1
skip = ["*-manylinux_i686", "*-musllinux_*", "*-win32", "pp*", "cp31?t-*"]
test-command = "pytest {project} -k \"not incompatible_with_mypyc\" -n auto"
test-extras = ["d", "jupyter"]
test-groups = ["tests"]
test-skip = ["*-macosx_arm64", "*-macosx_universal2:arm64"]

[tool.cibuildwheel.environment]
CC = "clang"
HATCH_BUILD_HOOKS_ENABLE = "1"
MYPYC_DEBUG_LEVEL = "0"
MYPYC_OPT_LEVEL = "3"

[tool.cibuildwheel.linux]
before-build = ["yum install -y clang"]
manylinux-x86_64-image = "manylinux_2_28"

[tool.coverage]

[tool.coverage.report]
omit = ["src/blib2to3/*", "tests/data/*", "*/site-packages/*", ".tox/*"]

[tool.coverage.run]
branch = true
relative_files = true

[tool.hatch]

[tool.hatch.build]

[tool.hatch.build.hooks]

[tool.hatch.build.hooks.vcs]
template = "version = \"{version}\"\n"
version-file = "src/_black_version.py"

[tool.hatch.build.targets]

[tool.hatch.build.targets.sdist]
exclude = ["/profiling"]

[tool.hatch.build.targets.wheel]
macos-max-compat = true
only-include = ["src"]
sources = ["src"]

[tool.hatch.build.targets.wheel.hooks]

[tool.hatch.build.targets.wheel.hooks.mypyc]
dependencies = ["hatch-mypyc>=0.16.0", "mypy==2.3.1"]
enable-by-default = false
exclude = ["/src/blackd", "/src/blib2to3/__init__.py", "/src/blib2to3/pgen2/__init__.py", "/src/black/output.py", "/src/black/concurrency.py", "/src/black/files.py", "/src/black/report.py", "/src/black/debug.py", "/src/black/__main__.py"]
mypy-args = ["--ignore-missing-imports"]
require-runtime-dependencies = true

[tool.hatch.build.targets.wheel.hooks.mypyc.options]
debug_level = "0"

[tool.hatch.metadata]

[tool.hatch.metadata.hooks]

[tool.hatch.metadata.hooks.fancy-pypi-readme]
content-type = "text/markdown"

[[tool.hatch.metadata.hooks.fancy-pypi-readme.fragments]]
path = "README.md"

[[tool.hatch.metadata.hooks.fancy-pypi-readme.fragments]]
path = "CHANGES.md"

[tool.hatch.version]
source = "vcs"

[tool.isort]
atomic = true
known_first_party = ["black", "blib2to3", "blackd", "_black_version"]
line_length = 88
profile = "black"
skip_gitignore = true
skip_glob = ["tests/data", "profiling"]

[tool.mypy]
implicit_reexport = true
mypy_path = "src"
python_version = "3.10"
show_column_numbers = true
show_error_codes = true
strict = true
warn_unreachable = true

[[tool.mypy.overrides]]
ignore_missing_imports = true
module = ["pathspec.*", "IPython.*", "colorama.*", "tokenize_rt.*", "uvloop.*"]

[[tool.mypy.overrides]]
ignore_errors = true
module = ["tests.data.*"]

[tool.pytest]

[tool.pytest.ini_options]
addopts = "--strict-config --strict-markers"
filterwarnings = ["error"]
markers = ["incompatible_with_mypyc: run when testing mypyc compiled black"]
optional-tests = ["no_blackd: run when `d` extra NOT installed", "no_jupyter: run when `jupyter` extra NOT installed"]
xfail_strict = true
