SELECT id, name FROM emp WHERE name NOT LIKE '%a%' AND dept IS NOT NULL ORDER BY id DESC LIMIT 7;
SELECT dept, COUNT(*), SUM(salary), MIN(age), MAX(age), AVG(salary) FROM emp GROUP BY dept;
UPDATE emp SET salary = salary + -377 WHERE dept = 'eng';
SELECT a.id, b.id FROM emp a JOIN emp b ON a.age = b.age WHERE a.id < b.id ORDER BY a.id, b.id;
SELECT a.id, b.id FROM emp a JOIN emp b ON a.age = b.age WHERE a.id < b.id ORDER BY a.id, b.id;
SELECT dept, COUNT(*), SUM(salary), MIN(age), MAX(age), AVG(salary) FROM emp GROUP BY dept;
SELECT age / 10, COUNT(*), AVG(salary) FROM emp WHERE age IS NOT NULL GROUP BY age ORDER BY 1, 2 DESC, age;
SELECT COUNT(*), SUM(salary), AVG(age), MIN(name), MAX(name) FROM emp WHERE dept IS NULL;
SELECT * FROM emp WHERE salary > 6230 ORDER BY id;
UPDATE emp SET dept = 'ops', age = age + 1 WHERE salary < 4033;
SELECT a.name, b.name FROM emp a, emp b WHERE a.dept = b.dept AND a.id < b.id AND a.salary > b.salary ORDER BY a.id, b.id;
SELECT * FROM emp ORDER BY dept, salary DESC, id;
SELECT dept, COUNT(*) AS n FROM emp WHERE age IS NOT NULL GROUP BY dept HAVING COUNT(*) > 2 ORDER BY n DESC, dept;
UPDATE emp SET dept = 'ops', age = age + 1 WHERE salary < 5406;
SELECT id, name FROM emp WHERE name LIKE 'A%' ORDER BY name, id;
SELECT e.id, d.floor * 1000 + e.salary FROM emp e JOIN dept d ON e.dept = d.dname WHERE e.salary IS NOT NULL ORDER BY 2 DESC, 1 LIMIT 5;
SELECT dept, MIN(name), MAX(name), COUNT(name) FROM emp GROUP BY dept ORDER BY dept DESC;
