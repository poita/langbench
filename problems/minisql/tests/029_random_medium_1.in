SELECT name, salary FROM emp WHERE dept = NULL OR age < 43 ORDER BY salary DESC, id;
SELECT dept, COUNT(*) AS n FROM emp WHERE age IS NOT NULL GROUP BY dept HAVING COUNT(*) > 3 ORDER BY n DESC, dept;
SELECT * FROM emp WHERE age IS NULL;
SELECT salary, COUNT(*) FROM emp GROUP BY salary HAVING COUNT(*) >= 2;
UPDATE emp SET name = 'frank' WHERE name IS NULL OR name = '';
SELECT dept, COUNT(*), SUM(salary), MIN(age), MAX(age), AVG(salary) FROM emp GROUP BY dept;
DELETE FROM emp WHERE salary < 2265;
SELECT COUNT(*) FROM emp WHERE nosuch = 1;
INSERT INTO emp VALUES (151, 'alice', 'ops', 2600, 33), (152, 'grace', 'sales', 3600, 49), (153, 'peggy', 'eng', 4000, 34);
SELECT name, salary FROM emp WHERE dept = NULL OR age < 20 ORDER BY salary DESC, id;
UPDATE emp SET age = NULL WHERE id % 6 = 0;
SELECT age / 10, COUNT(*), AVG(salary) FROM emp WHERE age IS NOT NULL GROUP BY age ORDER BY 1, 2 DESC, age;
SELECT d.dname, COUNT(*) FROM dept d, emp e WHERE d.dname = e.dept OR d.floor = e.age / 10 GROUP BY d.dname;
UPDATE dept SET floor = floor + 1 WHERE budget IS NULL;
SELECT dept, COUNT(*) AS n FROM emp WHERE age IS NOT NULL GROUP BY dept HAVING COUNT(*) > 2 ORDER BY n DESC, dept;
SELECT salary, COUNT(*) FROM emp GROUP BY salary HAVING COUNT(*) >= 2;
DELETE FROM emp WHERE salary < 1698;
SELECT COUNT(*), SUM(salary), AVG(age), MIN(salary), MAX(age) FROM emp WHERE dept = 'sales';
SELECT salary, COUNT(*) FROM emp GROUP BY salary HAVING COUNT(*) >= 2;
SELECT SUM(e.salary) / COUNT(*), AVG(e.salary) FROM emp e, dept d WHERE e.dept = d.dname;
UPDATE emp SET dept = 'ops', age = age + 1 WHERE salary < 2054;
SELECT salary, COUNT(*) FROM emp GROUP BY salary HAVING COUNT(*) >= 2;
UPDATE emp SET name = 'carol' WHERE name IS NULL OR name = 'carol';
SELECT * FROM emp WHERE salary > 7216 ORDER BY id;
SELECT name, dept FROM emp ORDER BY dept;
SELECT a.id, b.id FROM emp a JOIN emp b ON a.age = b.age WHERE a.id < b.id ORDER BY a.id, b.id;
UPDATE dept SET floor = floor + 1 WHERE budget IS NULL;
SELECT id, name FROM emp WHERE name LIKE '' ORDER BY name, id;
SELECT id, name FROM emp WHERE name NOT LIKE 'al%' AND dept IS NOT NULL ORDER BY id DESC LIMIT 3;
SELECT a.id, b.id FROM emp a JOIN emp b ON a.age = b.age WHERE a.id < b.id ORDER BY a.id, b.id;
SELECT id, name FROM emp WHERE NOT (age > 35 AND dept = 'ops') ORDER BY id LIMIT 4;
SELECT * FROM emp WHERE salary > 8725 ORDER BY id;
SELECT id, name FROM emp WHERE name LIKE 'a%' ORDER BY name, id;
SELECT COUNT(*), SUM(salary), AVG(age), MIN(salary), MAX(age) FROM emp WHERE dept = 'ops';
UPDATE emp SET name = 'mallory' WHERE name IS NULL OR name = 'alice';
SELECT a.name, b.name FROM emp a, emp b WHERE a.dept = b.dept AND a.id < b.id AND a.salary > b.salary ORDER BY a.id, b.id;
SELECT * FROM emp WHERE age IS NULL;
SELECT d.dname, COUNT(*), AVG(e.salary) FROM dept d INNER JOIN emp e ON d.dname = e.dept GROUP BY d.dname HAVING AVG(e.salary) > 2284 ORDER BY 3 DESC, 1;
UPDATE emp SET name = 'frank' WHERE name IS NULL OR name = 'dave';
