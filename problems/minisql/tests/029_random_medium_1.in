SELECT * FROM emp WHERE salary > 3656 ORDER BY id;
UPDATE emp SET age = NULL WHERE id % 7 = 0;
SELECT id FROM emp ORDER BY age DESC;
SELECT e.name, d.floor FROM emp e, dept d WHERE e.dept = d.dname AND d.floor > 0 ORDER BY e.id;
