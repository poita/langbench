SELECT a.id, b.id FROM emp a JOIN emp b ON a.age = b.age WHERE a.id < b.id ORDER BY a.id, b.id;
SELECT e.id, d.floor * 1000 + e.salary FROM emp e JOIN dept d ON e.dept = d.dname WHERE e.salary IS NOT NULL ORDER BY 2 DESC, 1 LIMIT 5;
SELECT * FROM emp WHERE age IS NULL;
INSERT INTO emp VALUES (301, 'trent', 'ops', 2200, 35);
UPDATE emp SET name = 'judy' WHERE name IS NULL OR name = 'bob';
UPDATE emp SET dept = 'eng', age = age + 1 WHERE salary < 6197;
SELECT id, age, age IS NULL, age > 50, NOT age > 59 FROM emp WHERE id % 3 = 0 ORDER BY id;
SELECT e.name, d.budget FROM emp AS e INNER JOIN dept AS d ON e.dept = d.dname ORDER BY d.budget DESC, e.name, e.id LIMIT 10 OFFSET 0;
SELECT name, salary * 2 - age AS s FROM emp WHERE salary % 1100 = 0 ORDER BY s, id;
SELECT e.name FROM emp e JOIN dept d ON e.dept = d.dname AND e.salary > d.budget * 7 ORDER BY e.id;
SELECT dept, age, COUNT(*) FROM emp GROUP BY dept, age HAVING age IS NULL OR COUNT(*) > 1;
SELECT dept, age, COUNT(*) FROM emp GROUP BY dept, age HAVING age IS NULL OR COUNT(*) > 1;
SELECT id, name FROM emp WHERE name NOT LIKE 'A%' AND dept IS NOT NULL ORDER BY id DESC LIMIT 1;
SELECT dept, MIN(name), MAX(name), COUNT(name) FROM emp GROUP BY dept ORDER BY dept DESC;
SELECT name, salary * 2 - age AS s FROM emp WHERE salary % 1100 = 0 ORDER BY s, id;
SELECT id, name FROM emp WHERE name NOT LIKE '%e' AND dept IS NOT NULL ORDER BY id DESC LIMIT 5;
SELECT id FROM emp ORDER BY age DESC;
UPDATE emp SET nosuch = 1;
SELECT name, dept FROM emp ORDER BY dept;
SELECT dept, COUNT(*), SUM(salary), MIN(age), MAX(age), AVG(salary) FROM emp GROUP BY dept;
SELECT * FROM emp WHERE age IS NULL;
INSERT INTO emp VALUES (302, 'judy', 'sales', 6000, 27);
UPDATE emp SET name = 'oscar' WHERE name IS NULL OR name = 'Al';
SELECT a.name, b.name FROM emp a, emp b WHERE a.dept = b.dept AND a.id < b.id AND a.salary > b.salary ORDER BY a.id, b.id;
SELECT dept, MIN(name), MAX(name), COUNT(name) FROM emp GROUP BY dept ORDER BY dept DESC;
UPDATE emp SET name = 'peggy' WHERE name IS NULL OR name = 'heidi';
SELECT dept, COUNT(*), SUM(salary), MIN(age), MAX(age), AVG(salary) FROM emp GROUP BY dept;
SELECT e.name, d.floor FROM emp e, dept d WHERE e.dept = d.dname AND d.floor > 1 ORDER BY e.id;
SELECT name, salary FROM emp WHERE dept = 'sales' OR age < 27 ORDER BY salary DESC, id;
SELECT e.name, d.floor FROM emp e, dept d WHERE e.dept = d.dname AND d.floor > 2 ORDER BY e.id;
SELECT id, name FROM emp WHERE name NOT LIKE '____' AND dept IS NOT NULL ORDER BY id DESC LIMIT 5;
SELECT * FROM emp WHERE age IS NULL;
SELECT dept, COUNT(*), SUM(salary), MIN(age), MAX(age), AVG(salary) FROM emp GROUP BY dept;
SELECT id, name FROM emp WHERE NOT (age > 30 AND dept = 'ops') ORDER BY id LIMIT 11;
SELECT id, name FROM emp WHERE NOT (age > 57 AND dept = 'sales') ORDER BY id LIMIT 6;
UPDATE emp SET name = '' WHERE name IS NULL OR name = 'peggy';
SELECT dept, age, COUNT(*) FROM emp GROUP BY dept, age HAVING age IS NULL OR COUNT(*) > 1;
SELECT SUM(e.salary) / COUNT(*), AVG(e.salary) FROM emp e, dept d WHERE e.dept = d.dname;
SELECT dept, COUNT(*), SUM(salary), MIN(age), MAX(age), AVG(salary) FROM emp GROUP BY dept;
SELECT a.name, b.name FROM emp a, emp b WHERE a.dept = b.dept AND a.id < b.id AND a.salary > b.salary ORDER BY a.id, b.id;
SELECT d.dname, COUNT(*) FROM dept d, emp e WHERE d.dname = e.dept OR d.floor = e.age / 10 GROUP BY d.dname;
SELECT d.dname, COUNT(*), AVG(e.salary) FROM dept d INNER JOIN emp e ON d.dname = e.dept GROUP BY d.dname HAVING AVG(e.salary) > 5956 ORDER BY 3 DESC, 1;
SELECT a.id, b.id FROM emp a JOIN emp b ON a.age = b.age WHERE a.id < b.id ORDER BY a.id, b.id;
SELECT dept, age, COUNT(*) FROM emp GROUP BY dept, age HAVING age IS NULL OR COUNT(*) > 1;
SELECT e.name, d.budget FROM emp AS e INNER JOIN dept AS d ON e.dept = d.dname ORDER BY d.budget DESC, e.name, e.id LIMIT 9 OFFSET 5;
SELECT id FROM emp ORDER BY age DESC;
UPDATE emp SET nosuch = 1;
SELECT SUM(e.salary) / COUNT(*), AVG(e.salary) FROM emp e, dept d WHERE e.dept = d.dname;
SELECT name, COUNT(*) FROM emp WHERE name LIKE '%' GROUP BY name ORDER BY 2 DESC, 1 LIMIT 3;
DELETE FROM emp WHERE salary < 2315;
SELECT * FROM emp ORDER BY dept, salary DESC, id;
SELECT e.name, d.budget FROM emp AS e INNER JOIN dept AS d ON e.dept = d.dname ORDER BY d.budget DESC, e.name, e.id LIMIT 2 OFFSET 3;
SELECT salary, COUNT(*) FROM emp GROUP BY salary HAVING COUNT(*) >= 2;
SELECT * FROM emp WHERE;
SELECT e.id, d.floor * 1000 + e.salary FROM emp e JOIN dept d ON e.dept = d.dname WHERE e.salary IS NOT NULL ORDER BY 2 DESC, 1 LIMIT 5;
UPDATE emp SET age = NULL WHERE id % 8 = 0;
