@module main
fn sl(xs: [Int]) -> Str { "[" ++ strJoin(listMap(xs, |v| showInt(v)), ",") ++ "]" }
fn sm(m: #[Str: Int]) -> Str {
    "{" ++ strJoin(listMap(pairsOf(m), |p| quoteStr(fst(p)) ++ ":" ++ showInt(snd(p))), ",") ++ "}"
}
fn main() {
    var xs: [Int] = listNew();
    var ys: [Int] = listNew();
    var m: #[Str: Int] = mapNew();
    var s = "start";
    var cs: [Char] = listNew();
    emit(showInt(strIndexOf(s, "")) ++ "," ++ showInt(strLastIndexOf(s, "hello")) ++ " ");
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(0), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    xs = reverseList(xs);
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(1), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    emit(showInt(strIndexOf(s, "hello")) ++ "," ++ showInt(strLastIndexOf(s, "hello")) ++ " ");
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(2), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    s = strJoin(strSplit(s, "/"), "/");
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(3), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    xs = listFilter(xs, |v| v % 4 != 0);
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(4), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    emit(showBool(mapDel(m, "é")) ++ " ");
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(5), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    emit(showBool(listContains(xs, 5)) ++ showInt(listIndexOf(xs, -9)) ++ " ");
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(6), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    emit(showBool(mapDel(m, "é")) ++ " ");
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(7), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    push(xs, 94);
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(8), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    emit(showBool(mapDel(m, "x")) ++ " ");
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(9), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    xs = sortBy(xs, |p, q| cmpI(-p, -q));
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(10), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    for c in chars("ab") { push(cs, c); }
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(11), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    s = s ++ "abc";
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(12), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    xs = listMap(xs, |v| v * 8 % 101);
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(13), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    emit(showBool(mapDel(m, "hello")) ++ " ");
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(14), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    if listLen(xs) > 0 { emit("rm " ++ showInt(removeAt(xs, modFloor(50, listLen(xs)))) ++ " "); }
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(15), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    push(xs, 70);
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(16), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    if listLen(xs) > 0 { emit("rm " ++ showInt(removeAt(xs, modFloor(13, listLen(xs)))) ++ " "); }
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(17), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    s = if strLen(s) > 40 { strReverse(substr(s, 0, 20)) } else { s };
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(18), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    if listLen(xs) > 0 { emit("rm " ++ showInt(removeAt(xs, modFloor(9, listLen(xs)))) ++ " "); }
    print(fmt("{} xs={} ys={} m={} s={}", [showInt(19), sl(xs), showInt(listLen(ys)), sm(m), quoteStr(s)]));
    s = strReplace(s, "c", "abc");
