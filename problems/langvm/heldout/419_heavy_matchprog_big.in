@module main
enum Color { Red, Green, Blue }
enum Shape { Dot, Seg(Int), Box(Int, Int), Tagged(Color, Shape) }
fn dc(c: Color) -> Str { match c { Red -> "R", Green -> "G", Blue -> "B" } }
fn ds(s: Shape) -> Str {
    match s {
        Dot -> ".",
        Seg(n) -> "S" ++ showInt(n),
        Box(a, b) -> "B" ++ showInt(a) ++ "x" ++ showInt(b),
        Tagged(c, t) -> dc(c) ++ "<" ++ ds(t) ++ ">",
    }
}
fn dopt(o: Option<Shape>) -> Str { match o { Some(s) -> "?" ++ ds(s), None -> "-" } }
fn dl(xs: [Int]) -> Str { "[" ++ strJoin(listMap(xs, |v| showInt(v)), " ") ++ "]" }
fn g0(x0: [Int], x1: Bool) -> Str {
    match (x0, x1) {
        (p0, true) when showInt(0) != "" -> "0:" ++ dl(p0),
        ([], false) -> "1",
        ([0, -1, ..], false) -> "2",
        (_, p0) when false -> "3:" ++ showBool(p0),
        _ -> "other",
    }
}
fn g1(x0: Shape) -> Str {
    match x0 {
        Tagged(Red, Tagged(Blue, Dot)) -> "0",
        Seg(-2) -> "1",
        Seg(_) -> "2",
        _ -> "other",
    }
}
fn g2(x0: Color, x1: Bool) -> Str {
    match (x0, x1) {
        (_, _) -> "0",
    }
}
fn g3(x0: Shape, x1: Int) -> Str {
    match (x0, x1) {
        (Seg(_), 1) -> "0",
        (Box(p0, -1), _) -> "1:" ++ showInt(p0),
        (Tagged(Green, Dot), p0) when false -> "2:" ++ showInt(p0),
        (Tagged(Red, p0), -2) -> "3:" ++ ds(p0),
        (Seg(-1), -2) -> "4",
        _ -> "other",
    }
}
fn g4(x0: Option<Shape>) -> Str {
    match x0 {
        Some(Seg(2)) -> "0",
        _ -> "1",
    }
}
fn g5(x0: [Int]) -> Str {
    match x0 {
        [_, 1] -> "0",
        p0 -> "1:" ++ dl(p0),
    }
}
fn g6(x0: Option<Shape>, x1: Color) -> Str {
    match (x0, x1) {
        (None, Red) -> "0",
        (Some(Seg(0)), Green) -> "1",
        (None, Green) -> "2",
        (_, Blue) -> "4",
        (Some(_), Red) -> "5",
        _ -> "other",
    }
}
fn g7(x0: [Int], x1: Bool) -> Str {
    match (x0, x1) {
        ([1, -1], false) -> "0",
        ([2], false) -> "1",
        ([..], _) -> "2",
    }
}
fn g8(x0: Bool, x1: Bool, x2: Color) -> Str {
    match (x0, x1, x2) {
        (true, false, Blue) -> "0",
        (true, false, Green) -> "1",
        _ -> "other",
    }
}
fn g9(x0: [Int]) -> Str {
    match x0 {
        [-2] -> "0",
        [0, 2, ..] -> "1",
        [-2, -2] -> "2",
        [1, -2, ..] -> "4",
        [-2, -1, ..] -> "5",
        _ -> "other",
    }
}
fn g10(x0: Bool, x1: Bool, x2: Color) -> Str {
    match (x0, x1, x2) {
        (true, true, Red) -> "0",
        (false, false, p0) -> "1:" ++ dc(p0),
        (true, true, Green) -> "2",
        (_, true, Green) -> "3",
        _ -> "other",
    }
}
fn g11(x0: [Int], x1: Bool) -> Str {
    match (x0, x1) {
        ([p0, -1], _) when false -> "0:" ++ showInt(p0),
        ([1, -2], true) -> "1",
        ([_], false) -> "2",
        ([], p0) when showInt(3) != "" -> "3:" ++ showBool(p0),
        ([0, 1, ..rest0], _) -> "4:" ++ dl(rest0),
        _ -> "other",
    }
}
fn g12(x0: [Int], x1: Bool) -> Str {
    match (x0, x1) {
        ([..], true) -> "0",
        ([..], false) -> "1",
    }
}
fn g13(x0: Bool, x1: Bool, x2: Color) -> Str {
    match (x0, x1, x2) {
        (false, false, Blue) -> "0",
        (false, false, Green) -> "1",
        (true, true, p0) -> "2:" ++ dc(p0),
        _ -> "other",
    }
}
fn g14(x0: Bool, x1: Bool, x2: Color) -> Str {
    match (x0, x1, x2) {
        (false, false, _) -> "0",
        (true, false, Red) -> "1",
        (_, p0, Blue) -> "2:" ++ showBool(p0),
        (false, _, Green) -> "3",
        (false, true, Red) -> "4",
        (p0, _, Green) -> "6:" ++ showBool(p0),
        _ -> "other",
    }
}
fn g15(x0: Option<Shape>, x1: Color) -> Str {
    match (x0, x1) {
        (Some(Box(-1, -1)), Green) -> "0",
        (Some(Seg(_)), Green) -> "1",
        (Some(p0), Green) -> "2:" ++ ds(p0),
        _ -> "other",
    }
}
fn g16(x0: Option<Shape>) -> Str {
    match x0 {
        None -> "0",
        Some(Box(2, -2)) -> "1",
        Some(Tagged(Blue, Tagged(_, _))) -> "2",
        Some(_) -> "3",
    }
}
fn g17(x0: Shape, x1: Int) -> Str {
    match (x0, x1) {
        (p0, -2) when showInt(0) != "" -> "0:" ++ ds(p0),
        (Seg(p0), 2) when false -> "1:" ++ showInt(p0),
        (Seg(-1), 1) -> "2",
        _ -> "other",
    }
}
fn g18(x0: Color, x1: Bool) -> Str {
    match (x0, x1) {
        (Green, true) -> "0",
        (Red, false) -> "1",
        (Green, p0) when true -> "2:" ++ showBool(p0),
        (Green, false) -> "3",
        _ -> "other",
    }
}
fn g19(x0: Shape, x1: Int) -> Str {
    match (x0, x1) {
        (Tagged(Blue, Box(2, 0)), 0) -> "0",
        (Tagged(Blue, Seg(-2)), -2) -> "1",
        (Seg(p0), -1) -> "2:" ++ showInt(p0),
        (Box(-2, p0), p1) -> "3:" ++ showInt(p0) ++ "," ++ showInt(p1),
        (_, -1) -> "4",
        (Tagged(_, Seg(-1)), 1) -> "5",
        (Tagged(_, Seg(-2)), 0) -> "6",
        _ -> "other",
    }
}
fn g20(x0: Option<Shape>, x1: Color) -> Str {
    match (x0, x1) {
        (None, Blue) -> "0",
        (None, Green) -> "1",
        _ -> "other",
    }
}
fn g21(x0: Color, x1: Bool) -> Str {
    match (x0, x1) {
        (p0, true) -> "0:" ++ dc(p0),
        (Green, false) -> "2",
        (_, false) -> "3",
    }
}
fn g22(x0: Color, x1: Bool) -> Str {
    match (x0, x1) {
        (Red, true) -> "0",
        (Red, false) -> "1",
        (Green, false) -> "3",
        (_, false) -> "4",
        _ -> "other",
    }
}
fn g23(x0: Option<Shape>) -> Str {
    match x0 {
        _ -> "0",
    }
}
fn g24(x0: Option<Shape>) -> Str {
    match x0 {
        Some(Dot) -> "0",
        Some(_) -> "1",
        _ -> "other",
    }
}
fn g25(x0: Color, x1: Bool) -> Str {
    match (x0, x1) {
        (Blue, true) -> "0",
        _ -> "other",
    }
}
fn g26(x0: [Int], x1: Bool) -> Str {
    match (x0, x1) {
        ([-2, ..], true) -> "0",
        ([-1, _], false) -> "1",
        ([-1, p0, ..], true) -> "2:" ++ showInt(p0),
        (_, p0) -> "3:" ++ showBool(p0),
    }
}
fn g27(x0: [Int]) -> Str {
    match x0 {
        [-2] -> "0",
        [2, ..] -> "1",
        [-1, 2] -> "2",
        [_, ..] -> "3",
        _ -> "4",
    }
}
fn g28(x0: Option<Shape>, x1: Color) -> Str {
    match (x0, x1) {
        (Some(Dot), _) -> "0",
        (Some(Tagged(Green, Tagged(_, p0))), Red) when true -> "1:" ++ ds(p0),
        (p0, p1) -> "2:" ++ dopt(p0) ++ "," ++ dc(p1),
    }
}
fn g29(x0: Bool, x1: Bool, x2: Color) -> Str {
    match (x0, x1, x2) {
        (false, p0, Blue) -> "0:" ++ showBool(p0),
        (false, false, Green) -> "1",
        (true, _, Green) -> "2",
        (false, true, Green) -> "3",
        (_, false, Blue) -> "4",
        _ -> "other",
    }
}
fn g30(x0: [Int], x1: Bool) -> Str {
    match (x0, x1) {
        (_, false) -> "0",
        ([p0, 2], true) -> "1:" ++ showInt(p0),
        ([-2, ..], true) -> "3",
        _ -> "other",
    }
}
fn g31(x0: [Int]) -> Str {
    match x0 {
        [] -> "0",
        [1, 2] -> "1",
        [2, ..rest0] -> "2:" ++ dl(rest0),
        [..] -> "3",
    }
}
fn g32(x0: Bool, x1: Bool, x2: Color) -> Str {
    match (x0, x1, x2) {
        (false, true, Blue) -> "0",
        (true, _, Blue) -> "1",
        (true, false, p0) -> "2:" ++ dc(p0),
        (true, true, Red) -> "3",
        _ -> "other",
    }
}
fn g33(x0: Shape, x1: Int) -> Str {
    match (x0, x1) {
        (Dot, 2) -> "0",
        (p0, -2) -> "1:" ++ ds(p0),
        (Box(2, p0), 1) -> "3:" ++ showInt(p0),
        _ -> "other",
    }
}
fn g34(x0: Bool, x1: Bool, x2: Color) -> Str {
    match (x0, x1, x2) {
        (_, true, Green) -> "0",
        (false, false, p0) when showInt(1) != "" -> "1:" ++ dc(p0),
        (false, false, Blue) -> "2",
        (_, true, Blue) -> "3",
        (false, p0, Green) -> "4:" ++ showBool(p0),
        _ -> "other",
    }
}
fn g35(x0: Shape) -> Str {
    match x0 {
        Tagged(_, Seg(2)) -> "0",
        _ -> "1",
    }
}
fn g36(x0: [Int], x1: Bool) -> Str {
    match (x0, x1) {
        ([-1, 2], true) -> "0",
        ([-1], true) -> "1",
        _ -> "other",
    }
}
fn g37(x0: Option<Shape>) -> Str {
    match x0 {
        None -> "0",
        Some(Seg(-2)) -> "1",
        _ -> "other",
    }
}
fn g38(x0: Bool, x1: Bool, x2: Color) -> Str {
    match (x0, x1, x2) {
        (true, false, p0) when showInt(0) != "" -> "0:" ++ dc(p0),
        (true, _, Green) -> "1",
        (p0, _, Green) when false -> "2:" ++ showBool(p0),
        (false, true, _) -> "3",
        _ -> "other",
    }
}
fn g39(x0: [Int]) -> Str {
    match x0 {
        [1] -> "0",
        [2, 1, ..rest0] when false -> "1:" ++ dl(rest0),
        [-1, ..rest0] -> "2:" ++ dl(rest0),
        [-2, 1] -> "3",
        [2, -1] -> "4",
        [_, 0, ..] -> "6",
        _ -> "other",
    }
}
