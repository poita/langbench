@module main
trait Show { fn show(self) -> Str; }
impl Show for Int { fn show(self) -> Str { showInt(self) } }
impl<T: Show> Show for [T] {
    fn show(self) -> Str { "[" ++ strJoin(listMap(self, |x| x.show()), ",") ++ "]" }
}
fn render<T: Show>(x: T) -> Str { x.show() }
fn main() {
    print(render([[1, 2], [3]]));
    print(render(5));
}
