; A second, smaller valid Spiremark database.  It exists so that tests can
; exercise the constructs of SPEC.md sections 6 and 12 that no card in
; data/cards.spire uses: the (relics <scope> ...) selector, the vault, hand
; and rift zones of the (cards ...) selector, the (relic {filter}) target
; specification, and the (text "...") card clause.  EXT-019 onwards cover
; the remaining filters, conditions, amounts, aura statics and delayed-trigger
; timings of the effect language.  EXT-033 makes the trigger subject of a
; `blocked` ability observable.

(card EXT-001 (name "Chalk Figure") (type unit) (cost 0) (body 1 1)
  (tags ext mote))
(card EXT-002 (name "Relic Breaker") (type rite) (cost 2) (tags ext)
  (text "Shatter one of their relics.")
  (resolve (targets (relic (enemy))) (destroy (t 1))))
(card EXT-003 (name "Dust Wind") (type rite) (cost 1) (tags ext)
  (keywords swift)
  (resolve (damage 2 (relics all)) (damage 1 (units all))))
(card EXT-004 (name "Reliquary Rite") (type rite) (cost 2) (tags ext)
  (resolve (each (relics yours) (counters 1 that)) (ward 2 (relics yours))))
(card EXT-005 (name "Vault Purge") (type rite) (cost 3) (tags ext)
  (resolve (exile (cards vault yours (type unit)))))
(card EXT-006 (name "Hand Count") (type rite) (cost 1) (tags ext)
  (resolve (damage (count (cards hand theirs)) foe)))
(card EXT-007 (name "Rift Lens") (type relic) (cost 2) (tags ext)
  (text "Grows with the Rift.")
  (aura (modify (count (cards rift all)) 0 (units yours))))
(card EXT-008 (name "Chronicle Keeper") (type unit) (cost 3) (body 2 3)
  (tags ext cleric)
  (text "A card clause the CARD block never prints.")
  (on arrive (draw 1 you))
  (act (cost (ember 1) (exhaust)) (targets (relic)) (counters 1 (t 1)))
  (aura (grant vanguard (units yours (tag ext)))))
(card EXT-009 (name "Grave Return") (type rite) (cost 2) (tags ext)
  (resolve (recall (cards ash theirs (type unit)))))
(card EXT-010 (name "Twin Reliquaries") (type relic) (cost 3) (tags ext)
  (aura (when (count (relics yours) ge 2) (modify 2 2 (units yours)))))
(card EXT-011 (name "Counter Wright") (type unit) (cost 2) (body 1 4)
  (tags ext construct) (keywords (plating 1))
  (on your-turn-start (counters 2 self))
  (act (cost (counters 2)) (targets (relic)) (ward 3 (t 1))))
(card EXT-012 (name "Relic Tide") (type rite) (cost 1) (tags ext)
  (keywords swift)
  (resolve (targets (relic)) (bounce (t 1))))
(card EXT-013 (name "Figure Caller") (type unit) (cost 3) (body 2 2)
  (tags ext mage)
  (on arrive (summon EXT-001 2 both)))
(card EXT-014 (name "Shared Spoils") (type rite) (cost 2) (tags ext)
  (resolve (conjure EXT-001 2 both)))
(card EXT-015 (name "Ext Bazaar") (type relic) (cost 2) (tags ext)
  (aura (cheaper 2 (tag ext) (cost ge 3))))
(card EXT-016 (name "Shared Search") (type rite) (cost 2) (tags ext)
  (resolve (dig 2 ((tag ext)) both)))
(card EXT-017 (name "Deep Ledger") (type rite) (cost 3) (tags ext)
  (resolve (mill 2 both) (spire (count (cards ash all)) you)))
(card EXT-018 (name "Rift Warden") (type unit) (cost 4) (body 3 4)
  (tags ext construct) (keywords provoke tenacity)
  (on dies (exile (cards hand yours)))
  (aura (when (count (cards rift yours) ge 2) (grant venom (units yours)))))
(card EXT-019 (name "Lingering Ember") (type rite) (cost 1) (tags ext)
  (keywords swift)
  (resolve (targets (unit)) (modify 2 0 (t 1))
    (delay end-of-combat (damage 1 (t 1)))
    (delay your-next-turn-start (draw 1 you) (counters 1 (t 1)))))
(card EXT-020 (name "Sorting Wind") (type rite) (cost 2) (tags ext)
  (resolve (destroy (units all (wounded)))
    (exhaust (units theirs (ready)))
    (ready (units yours (exhausted)))))
(card EXT-021 (name "Combat Sense") (type rite) (cost 1) (tags ext)
  (keywords swift)
  (resolve (modify 1 0 (units all (attacking)))
    (modify 0 1 (units all (blocking)))
    (damage 1 (units all (settling)))))
(card EXT-022 (name "Keyword Sieve") (type rite) (cost 2) (tags ext)
  (resolve (bounce (units all (kw vanguard)))
    (counters 1 (units all (no-kw vanguard) (not (kw plating))))
    (exile (units all (kw plating) (not (mine))))))
(card EXT-023 (name "Measured Strike") (type rite) (cost 2) (tags ext)
  (resolve (targets (any (core le 3)))
    (damage (core (units yours)) (t 1))
    (repeat (count (units yours (edge lt 2))) (draw 1 you))))
(card EXT-024 (name "Balance Check") (type rite) (cost 1) (tags ext)
  (keywords swift)
  (resolve (if (or (ember you ge 3) (spire foe lt 10)) ((ember 1 you))
                                                       ((cap 2 both)))
    (if (and (vault both gt 5) (not (ash you eq 0))) ((mill 1 both)))))
(card EXT-025 (name "Wound Reader") (type unit) (cost 2) (body 2 4)
  (tags ext mage)
  (on damaged (if (count (units yours (wounded)) ge 2)
                  ((ward (wounds self) self))))
  (on deals-damage (counters 1 it)))
(card EXT-026 (name "Distortion Idol") (type relic) (cost 3) (tags ext)
  (aura (setbody 2 2 (units theirs (no-kw vanguard) (edge le 1))))
  (aura (swapstats (units yours (core gt 5)))))
(card EXT-027 (name "Mirror Warden") (type unit) (cost 2) (body 1 1)
  (tags ext construct)
  (aura (modify 0 (core (units theirs)) self))
  (aura (when (count (units yours (core ge 3)) ge 2)
          (modify (edge (units theirs)) 0 self))))
(card EXT-028 (name "Drain Rite") (type rite) (cost 1) (tags ext)
  (resolve (targets (unit)) (counters -2 (t 1))
    (spire (wounds (t 1)) both)
    (shield (vault foe) both)))
(card EXT-029 (name "Blind Search") (type rite) (cost 1) (tags ext)
  (resolve (dig 0 ((type unit)) you) (dig 9 ((kw vanguard)) foe)))
(card EXT-030 (name "Stray Spark") (type rite) (cost 1) (tags ext)
  (keywords swift)
  (resolve (damage 1 (random-unit all (no-kw plating)))
    (damage 1 (random-unit yours (kw tenacity)))))
(card EXT-031 (name "Toll of Names") (type rite) (cost 1) (tags ext)
  (resolve (targets (player)) (draw 1 (owner-of (t 1))) (discard 1 (t 1))
    (spire -1 (owner-of (units all (kw provoke))))))
(card EXT-032 (name "Quartermaster") (type unit) (cost 3) (body 2 3)
  (tags ext soldier) (keywords vanguard)
  (act (cost (spire 1) (counters 1) (discard 1)) (targets (unit (other)))
    (counters 2 (t 1)) (ready self))
  (on your-turn-start (counters 1 self)))
(card EXT-033 (name "Snare Hound") (type unit) (cost 2) (body 3 3)
  (tags ext beast)
  (on blocked (damage 1 it)))
