{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "contains": {
      "const": 1
    },
    "minContains": 1,
    "maxContains": 3
  },
  "tests": [
    {
      "description": "actual < minContains < maxContains",
      "data": []
    },
    {
      "description": "minContains < actual < maxContains",
      "data": [
        1,
        1
      ]
    },
    {
      "description": "minContains < maxContains < actual",
      "data": [
        1,
        1,
        1,
        1
      ]
    }
  ]
}
