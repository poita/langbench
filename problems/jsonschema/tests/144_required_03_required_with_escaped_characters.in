{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "foo\nbar",
      "foo\"bar",
      "foo\\bar",
      "foo\rbar",
      "foo\tbar",
      "foo\fbar"
    ]
  },
  "tests": [
    {
      "description": "object with all properties present is valid",
      "data": {
        "foo\nbar": 1,
        "foo\"bar": 1,
        "foo\\bar": 1,
        "foo\rbar": 1,
        "foo\tbar": 1,
        "foo\fbar": 1
      }
    },
    {
      "description": "object with some properties missing is invalid",
      "data": {
        "foo\nbar": "1",
        "foo\"bar": "1"
      }
    }
  ]
}
