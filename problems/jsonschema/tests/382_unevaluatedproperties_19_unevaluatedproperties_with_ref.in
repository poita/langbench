{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/bar",
    "properties": {
      "foo": {
        "type": "string"
      }
    },
    "unevaluatedProperties": false,
    "$defs": {
      "bar": {
        "properties": {
          "bar": {
            "type": "string"
          }
        }
      }
    }
  },
  "tests": [
    {
      "description": "with no unevaluated properties",
      "data": {
        "foo": "foo",
        "bar": "bar"
      }
    },
    {
      "description": "with unevaluated properties",
      "data": {
        "foo": "foo",
        "bar": "bar",
        "baz": "baz"
      }
    }
  ]
}
