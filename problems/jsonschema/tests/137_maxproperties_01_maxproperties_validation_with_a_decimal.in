{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "maxProperties": 2.0
  },
  "tests": [
    {
      "description": "shorter is valid",
      "data": {
        "foo": 1
      }
    },
    {
      "description": "too long is invalid",
      "data": {
        "foo": 1,
        "bar": 2,
        "baz": 3
      }
    }
  ]
}
