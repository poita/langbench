    "contains": {
      "const": 1
    },
    "maxContains": 1,
    "minContains": 3
  },
  "tests": [
    {
      "description": "empty data",
      "data": []
    },
    {
      "description": "invalid minContains",
      "data": [
        1
      ]
    },
    {
      "description": "invalid maxContains",
      "data": [
        1,
