{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "if": {
      "exclusiveMaximum": 0
    },
    "then": {
      "minimum": -10
    },
    "else": {
      "multipleOf": 2
    }
  },
  "tests": [
