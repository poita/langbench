{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "foo": {
        "prefixItems": [
          {
            "type": "string"
          }
        ],
        "unevaluatedItems": false
      }
    },
    "anyOf": [
      {
        "properties": {
          "foo": {
            "prefixItems": [
              true,
              {
                "type": "string"
              }
            ]
          }
        }
      }
    ]
  },
  "tests": [
    {
      "description": "no extra items",
      "data": {
        "foo": [
          "test"
        ]
      }
    },
    {
      "description": "uncle keyword evaluation is not significant",
      "data": {
        "foo": [
          "test",
          "test"
        ]
      }
    }
  ]
}
