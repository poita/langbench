{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "unevaluatedProperties": true
      },
      {
        "properties": {
          "foo": {
            "type": "string"
          }
        },
        "unevaluatedProperties": false
      }
    ]
  },
  "tests": [
    {
      "description": "with no nested unevaluated properties",
      "data": {
        "foo": "foo"
      }
    },
    {
      "description": "with nested unevaluated properties",
      "data": {
        "foo": "foo",
        "bar": "bar"
      }
    }
  ]
}
