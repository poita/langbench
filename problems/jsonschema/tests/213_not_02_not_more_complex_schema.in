{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "not": {
      "type": "object",
      "properties": {
        "foo": {
          "type": "string"
        }
      }
    }
  },
  "tests": [
    {
      "description": "match",
      "data": 1
    },
    {
      "description": "other match",
      "data": {
        "foo": 1
      }
    },
    {
      "description": "mismatch",
      "data": {
        "foo": "bar"
      }
    }
  ]
