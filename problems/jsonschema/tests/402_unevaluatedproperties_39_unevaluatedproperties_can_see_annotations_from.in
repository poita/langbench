{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "if": {
      "patternProperties": {
        "foo": {
          "type": "string"
        }
      }
    },
    "unevaluatedProperties": false
  },
  "tests": [
    {
      "description": "valid in case if is evaluated",
      "data": {
        "foo": "a"
      }
    },
    {
      "description": "invalid in case if is evaluated",
      "data": {
        "bar": "a"
      }
    }
  ]
}
