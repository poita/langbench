{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "foo": {
        "properties": {
          "bar": {
            "type": "string"
          }
        },
        "unevaluatedProperties": false
      }
    },
    "anyOf": [
      {
        "properties": {
          "foo": {
            "properties": {
              "faz": {
                "type": "string"
              }
            }
          }
        }
      }
    ]
  },
  "tests": [
    {
      "description": "no extra properties",
      "data": {
        "foo": {
          "bar": "test"
        }
      }
    },
    {
      "description": "uncle keyword evaluation is not significant",
      "data": {
        "foo": {
          "bar": "test",
          "faz": "test"
        }
      }
    }
  ]
}
