{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "int": {
        "type": "integer"
      }
    },
    "allOf": [
      {
        "properties": {
          "foo": {
            "$ref": "#/$defs/int"
          }
        }
      },
      {
        "additionalProperties": {
          "$ref": "#/$defs/int"
        }
      }
    ]
  },
  "tests": [
    {
      "description": "passing case",
      "data": {
        "foo": 1
      }
    },
    {
      "description": "failing case",
      "data": {
        "foo": "a string"
      }
    }
  ]
}
