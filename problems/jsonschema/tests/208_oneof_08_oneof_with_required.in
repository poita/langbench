{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "oneOf": [
      {
        "required": [
          "foo",
          "bar"
        ]
      },
      {
        "required": [
          "foo",
          "baz"
        ]
      }
    ]
  },
  "tests": [
    {
      "description": "both invalid - invalid",
      "data": {
        "bar": 2
      }
    },
    {
      "description": "first valid - valid",
      "data": {
        "foo": 1,
        "bar": 2
      }
    },
    {
      "description": "second valid - valid",
      "data": {
        "foo": 1,
        "baz": 3
      }
    },
    {
      "description": "both valid - invalid",
      "data": {
        "foo": 1,
        "bar": 2,
        "baz": 3
      }
    }
  ]
}
