{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "http://example.com/a.json",
    "$defs": {
      "x": {
        "$id": "http://example.com/b/c.json",
        "not": {
          "$defs": {
            "y": {
              "$id": "d.json",
              "type": "number"
            }
          }
        }
      }
    },
    "allOf": [
      {
        "$ref": "http://example.com/b/d.json"
      }
    ]
  },
  "tests": [
    {
      "description": "number is valid",
      "data": 1
    },
    {
      "description": "non-number is invalid",
      "data": "a"
    }
  ]
}
