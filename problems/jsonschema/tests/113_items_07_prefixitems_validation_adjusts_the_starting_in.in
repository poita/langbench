{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "prefixItems": [
      {
        "type": "string"
      }
    ],
    "items": {
      "type": "integer"
    }
  },
  "tests": [
    {
      "description": "valid items",
      "data": [
        "x",
        2,
        3
      ]
    },
    {
      "description": "wrong type of second item",
      "data": [
        "x",
        "y"
      ]
    }
  ]
}
