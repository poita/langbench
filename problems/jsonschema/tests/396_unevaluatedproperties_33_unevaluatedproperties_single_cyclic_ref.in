  "tests": [
    {
      "description": "Empty is valid",
      "data": {}
    },
    {
      "description": "Single is valid",
      "data": {
        "x": {}
      }
    },
    {
      "description": "Unevaluated on 1st level is invalid",
      "data": {
        "x": {},
        "y": {}
      }
    },
    {
      "description": "Nested is valid",
      "data": {
        "x": {
          "x": {}
        }
      }
    },
    {
