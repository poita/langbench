{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "file:///folder/file.json",
    "$defs": {
      "foo": {
        "type": "number"
      }
    },
    "$ref": "#/$defs/foo"
  },
  "tests": [
    {
      "description": "number is valid",
      "data": 1
    },
    {
      "description": "non-number is invalid",
      "data": "a"
    }
  ]
}
