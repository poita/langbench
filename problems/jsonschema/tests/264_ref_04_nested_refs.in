{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "a": {
        "type": "integer"
      },
      "b": {
        "$ref": "#/$defs/a"
      },
      "c": {
        "$ref": "#/$defs/b"
      }
    },
    "$ref": "#/$defs/c"
  },
  "tests": [
    {
      "description": "nested ref valid",
      "data": 5
    },
    {
      "description": "nested ref invalid",
      "data": "a"
    }
  ]
}
