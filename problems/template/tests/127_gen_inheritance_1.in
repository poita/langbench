{% block b3_in %}mid1[]{% endblock %}
{% block b5_in %}mid1[{{ lvl_mid1 }}]{% endblock %}

=== base
<base>{% block b0 %}base-b0{% endblock %}
{% block b1 %}base-b1{% endblock %}
{% block b2 %}base-b2{% endblock %}
{% block b3 %}base-b3{% endblock %}
{% block b4 %}base-b4({% block b4_in %}in-b4{% endblock %}){% endblock %}
{% block b5 %}base-b5{% endblock %}
{% block b6 %}base-b6({% block b6_in %}in-b6{% endblock %}){% endblock %}
{% block b7 %}base-b7{% endblock %}
