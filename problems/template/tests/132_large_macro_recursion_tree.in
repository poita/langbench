=== main
{% macro render(node, depth) %}{{ "  " * depth }}{{ node.name }}={{ node.value }}{% if node.children %} ({{ node.children|length }}){% endif %}
{% for c in node.children %}{{ render(c, depth + 1) }}{% endfor %}{% endmacro %}{% macro total(node) %}{{ node.value + sum_rest(node.children, 0)|int }}{% endmacro %}{% macro sum_rest(list, i) %}{% if i < list|length %}{{ total(list[i])|int + sum_rest(list, i + 1)|int }}{% else %}0{% endif %}{% endmacro %}{% macro loop_set_demo(node) %}{% set acc = node.value %}{% for c in node.children %}{% set acc = acc + c.value %}{% endfor %}{{ acc }}{% endmacro %}{% macro count(node) %}{{ 1 + count_rest(node.children, 0)|int }}{% endmacro %}{% macro count_rest(list, i) %}{% if i < list|length %}{{ count(list[i])|int + count_rest(list, i + 1)|int }}{% else %}0{% endif %}{% endmacro %}{{ render(tree, 0) }}total={{ total(tree) }} nodes={{ count(tree) }} demo={{ loop_set_demo(tree) }}
