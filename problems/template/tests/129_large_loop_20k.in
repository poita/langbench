=== main
{% macro money(cents) %}{{ cents // 100 }}.{% if cents % 100 < 10 %}0{% endif %}{{ cents % 100 }}{% endmacro -%}
{{ title|upper }}
{% for it in items -%}
{{ loop.index }}. {{ it.name|lower }} x{{ it.qty }} @ {{ money(it.price) }} = {{ money(it.qty * it.price) }}{% if it.tags %} [{{ it.tags|sort|join(",") }}]{% endif %}{% if not it.active %} (inactive){% endif %}{% if it.note|trim %} note={{ it.note|trim|escape }}{% endif %}{% if loop.first %} FIRST{% elif loop.last %} LAST{% endif %}
{% endfor -%}
count={{ items|length }} last={{ (items|last).name }} first={{ (items|first).id }}
