older(X, Y) :- age(X, A), age(Y, B), A > B.
same(X, Y) :- age(X, A), age(Y, A), X != Y.
oldest(X) :- age(X, _), not beaten(X).
beaten(X) :- older(_, X).
youngest(X) :- age(X, _), not beats(X).
beats(X) :- older(X, _).
adult(X) :- age(X, A), A >= 18.
minor(X) :- age(X, _), not adult(X).
?- oldest(X).
?- youngest(X).
?- minor(X).
?- same(p1, X).
?- older(p2, X).
?- older(X, p3).
