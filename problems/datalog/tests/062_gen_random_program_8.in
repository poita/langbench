d10(Y, Y) :- b0(Y), not b0(Y), Y <= 2.
d10(X, Y) :- d10(X, Y), b0(Z), b0(Z), X = 1, not b1(Y).
d11(Y, Y, Y) :- d10(W, X), d11(W, Y, 0), not b2(Y, W).
d11(Z, a, Z) :- d11(Y, 3, Z).
d20(Y, 3) :- b2(X, Z), b2(W, Z), b2(Y, X), not b0(Y).
d20(Y, Y) :- d20(Z, Y), b1(Y), b0(Y).
d20(Z, X) :- d10(Z, X), d20(-1, X), b2(X, X), Z > 0.
d21(X) :- b0(2), b2(X, X).
d21(Y) :- d10(_, X), b1(Y), X >= c.
d21(Y) :- b2(W, Y), d10(Z, Z).
d30(b, X, X) :- d20(Z, X), X != Z.
d30(Z, Z, X) :- d20(_, X), d10(Z, W), b0(Z), not b1(X), W = Z.
d30(W, W, W) :- b1(W), b1(W), not d11(W, W, W), W != 3.
d31(Z, b) :- b0(Z), d10(X, X).
d31(a, W) :- Z != W, b0(Z), b0(W), not d11(W, W, W), d20(W, Z).
d31(Z, Z) :- d20(Y, Y), d10(Y, Z), not b2(1, Z).
?- b0(X).
?- b1(X).
?- b1(a).
?- b2(X, Y).
?- d10(X, Y).
?- d11(X, Y, Z).
?- d11(X, X, X).
?- d20(X, Y).
?- d21(X).
?- d21(_).
?- d30(X, Y, Z).
?- d31(X, Y).
