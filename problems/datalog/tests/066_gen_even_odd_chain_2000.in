even(X) :- zero(X).
even(X) :- succ(Y, X), odd(Y).
odd(X) :- succ(Y, X), even(Y).
?- even(2000).
?- odd(2000).
?- odd(1999).
neither(X) :- succ(X, _), not even(X), not odd(X).
?- neither(X).
?- even(X).
