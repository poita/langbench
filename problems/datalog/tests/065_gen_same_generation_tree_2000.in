sg(X, X) :- par(_, X).
sg(X, X) :- par(X, _).
sg(X, Y) :- par(XP, X), sg(XP, YP), par(YP, Y).
?- sg(1, X).
?- sg(2000, X).
?- sg(1000, X).
?- sg(X, 7).
count(X) :- sg(X, Y), X < Y.
?- count(X).
alone(X) :- par(_, X), not count(X).
?- alone(X).
