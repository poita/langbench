d10(W, W, W) :- b0(Z, W, X), Z > X, b2(Z, W).
d10(Y, c, X) :- b0(c, X, Y).
d10(X, Y, 1) :- d10(W, Z, X), b2(X, 3), d10(Z, 0, Y), Y <= W.
d11(W) :- d11(Y), b0(Y, Y, W).
d11(W) :- X != W, b0(X, W, Z), b0(Y, Z, Y).
d20(W, W, W) :- W = Z, d10(Y, X, Z), b0(Y, -1, W), d10(Z, 0, X).
d20(-1, W, Y) :- d11(W), W > Z, b0(Z, Y, Y).
d20(W, W, Z) :- d20(W, W, _), not b2(Z, W), b0(Z, Z, Z).
d21(X, X) :- b2(X, X), d20(X, X, 0), not b2(X, X), X <= c.
d21(1, X) :- b0(Z, _, Z), b2(X, X), d10(W, X, X), W >= 1.
d21(Y, X) :- d20(Y, Z, Z), b2(X, Y).
d30(3, a, 2) :- b1(_).
d30(Z, Z, -1) :- b0(Z, Z, Y), d20(_, W, 2), b0(Z, Z, W), Y = 1.
d30(Z, 2, Y) :- d21(Y, Z), not b2(Z, Y).
d31(c, Y, Y) :- b0(_, Y, X), not d10(Y, X, X).
d31(Y, Y, Y) :- b1(Y), not d11(Y).
d31(Z, W, Z) :- b2(W, W), d21(W, X), d30(W, Z, Z).
