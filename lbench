def parse_toolchains(specs):
    """Turn ["d=ldc2", "go=/x/bin/go"] into {lang: path}."""
    out = {}
    for spec in specs:
        lang, sep, path = spec.partition("=")
        if not sep or not path:
            sys.exit(f"--toolchain wants LANG=PATH, not {spec!r}")
        if lang not in LANGS:
            sys.exit(f"--toolchain: unknown language {lang!r} (one of {', '.join(LANGS)})")
        out[lang] = path
    return out


def toolchain_info(lang, tool):
    """Describe a toolchain binary: path, version line, git revision; for D also its kind (dmd or ldc)."""
    path = shutil.which(tool) or tool
    path = os.path.abspath(path) if os.path.exists(path) else path
    try:
        r = subprocess.run([path] + VERSION_ARGS[lang], capture_output=True, text=True, timeout=30)
        ver = ((r.stdout or r.stderr).split("\n")[0]).strip()
    except OSError:
        ver = "unknown"
    info = {"lang": lang, "path": path, "version": ver, "git": "", "flags": []}
    if lang == "d":
        info["kind"] = "ldc" if "ldc" in os.path.basename(path) else "dmd"
    d = os.path.dirname(path)

    def common_dir(path):
        r = subprocess.run(["git", "-C", path, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                           capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else None
    # A snapshot copied into this benchmark's repository has no revision of its own;
    # its PROVENANCE.txt, if present, says where it came from.
    if common_dir(d) and common_dir(d) == common_dir(ROOT):
        prov = os.path.join(os.path.dirname(d), "PROVENANCE.txt")
        info["provenance"] = open(prov).read().strip() if os.path.exists(prov) else ""
        return info
    g = subprocess.run(["git", "-C", d, "rev-parse", "--short", "HEAD"], capture_output=True, text=True)
    if g.returncode == 0:
        dirty = subprocess.run(["git", "-C", d, "status", "--porcelain", "-uno"], capture_output=True, text=True).stdout.strip()
        info["git"] = g.stdout.strip() + ("-dirty" if dirty else "")
    return info


def compiler_info(dc):
    """Describe a D compiler (kept for callers that only deal with D)."""
    return toolchain_info("d", dc)


D_COMPILER = re.compile(r"(^|[\s;&|(]|exec\s)(?:[^\s=\-\"'][^\s=]*/)?(ldc2|ldmd2|dmd)(?=\s)", re.M)


def d_compiler_in(build_sh):
    """The D compiler a build script names (via dub --compiler= or as a command), or None."""
    m = re.search(r"--compiler=(\"[^\"]*\"|'[^']*'|\S+)", build_sh)
    if m:
        return m.group(1).strip("\"'")
    for line in build_sh.splitlines():
        if not line.lstrip().startswith("#"):
            c = D_COMPILER.search(line)
            if c:
                return c.group(2)
    return None


def write_script(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)
    os.chmod(path, 0o755)
    return path


def counting_wrapper(real, path, extra=()):
    """A script at path that runs real with its arguments (then extra), logging the process's own
    instructions and cycles to $LBENCH_TIMELOG when that is set."""
    tail = "".join(" " + shlex.quote(x) for x in extra)
    counters = " ".join(shlex.quote(x) for x in counter_prefix("LOG", append=True)).replace("LOG", '"$LBENCH_TIMELOG"')
    return write_script(path, "#!/bin/bash\n"
                              "if [ -n \"$LBENCH_TIMELOG\" ]; then\n"
                              f"  exec {counters} \"{real}\" \"$@\"{tail}\n"
                              "fi\n"
                              f"exec \"{real}\" \"$@\"{tail}\n")


@functools.lru_cache(maxsize=None)
def version_line(lang, tool):
    try:
        r = subprocess.run([tool] + VERSION_ARGS[lang], capture_output=True, text=True, timeout=30)
        return ((r.stdout or r.stderr).split("\n")[0]).strip()
    except OSError:
        return ""


def build_env(lang, tc, wrapdir, log, dst):
    """Environment for building one implementation: the chosen toolchain (or the default one on PATH),
    routed through counting wrappers so compile instructions are measured for every language."""
    env = dict(os.environ, LBENCH_TIMELOG=log)
    flags = " ".join((tc or {}).get("flags", []))
    path = (tc or {}).get("path")
    if lang == "cpp":
        real = path or shutil.which("c++") or "c++"
        # clang may run its compile stage (cc1) as a child process, which per-process counters
        # miss; -fintegrated-cc1 keeps it in the measured process without changing the output.
        ver = (tc or {}).get("version") or version_line("cpp", real)
        extra = ("-fintegrated-cc1",) if "clang" in ver.lower() else ()
        env["CXX"] = counting_wrapper(real, os.path.join(wrapdir, "cpp", os.path.basename(real)), extra)
        if flags:
            env["CXXFLAGS"] = flags
    elif lang == "rust":
        real = path or shutil.which("rustc") or "rustc"
        env["RUSTC"] = counting_wrapper(real, os.path.join(wrapdir, "rust", "rustc"))
        if flags:
            env["RUSTFLAGS"] = flags
    elif lang == "go":
        if path:
            env["PATH"] = os.path.dirname(os.path.abspath(path)) + os.pathsep + env.get("PATH", "")
        # go build -toolexec runs "toolexec <tool> <args>" for the compiler, assembler and linker.
        counters = " ".join(shlex.quote(x) for x in counter_prefix("LOG", append=True)).replace("LOG", '"$LBENCH_TIMELOG"')
        toolexec = write_script(os.path.join(wrapdir, "go", "toolexec"), "#!/bin/bash\n"
                                "if [ -n \"$LBENCH_TIMELOG\" ]; then\n"
                                f"  exec {counters} \"$@\"\n"
                                "fi\n"
                                "exec \"$@\"\n")
        env["GOFLAGS"] = " ".join(x for x in (env.get("GOFLAGS", ""), f"-toolexec={toolexec}", flags) if x)
        env["GOCACHE"] = os.path.join(wrapdir, "go", "cache")
    elif lang == "haskell":
        # cabal runs the ghc on PATH and expects ghc-pkg and the other tools beside it, so the wrapper directory
        # mirrors the real one with only ghc itself routed through a counting wrapper.
        real = os.path.realpath(shutil.which(path or "ghc") or path or "ghc")
        bindir = os.path.join(wrapdir, "haskell", "bin")
        os.makedirs(bindir, exist_ok=True)
        for name in os.listdir(os.path.dirname(real)):
            link = os.path.join(bindir, name)
            if os.path.lexists(link):
                os.unlink(link)
            os.symlink(os.path.join(os.path.dirname(real), name), link)
        for name in ("ghc", os.path.basename(real)):
            link = os.path.join(bindir, name)
            if os.path.lexists(link):
                os.unlink(link)
            counting_wrapper(real, link, tuple((tc or {}).get("flags", [])))
        env["PATH"] = bindir + os.pathsep + env.get("PATH", "")
        # Builds use GHC's own packages only, so cabal needs no package index (and must not download one).
        env["CABAL_DIR"] = os.path.join(wrapdir, "haskell", "cabal")
        os.makedirs(env["CABAL_DIR"], exist_ok=True)
        with open(os.path.join(env["CABAL_DIR"], "config"), "w") as f:
            f.write("active-repositories: :none\n")
    elif lang == "clojure" and path:
        env["PATH"] = os.path.dirname(os.path.abspath(shutil.which(path) or path)) + os.pathsep + env.get("PATH", "")
    elif lang == "python" and path:
        bindir = os.path.join(wrapdir, "python", "bin")
        os.makedirs(bindir, exist_ok=True)
        link = os.path.join(bindir, "python3")
        if os.path.lexists(link):
            os.unlink(link)
        os.symlink(os.path.abspath(shutil.which(path) or path), link)
        env["PATH"] = bindir + os.pathsep + env.get("PATH", "")
    return env


def run_env(toolchains, wrapdir):
    """Environment for running implementations: only an interpreter swap (Python) matters at run time."""
    env = dict(os.environ)
    if "python" in toolchains:
        env["PATH"] = os.path.join(wrapdir, "python", "bin") + os.pathsep + env.get("PATH", "")
    if (toolchains.get("clojure") or {}).get("path"):
        tool = toolchains["clojure"]["path"]
        env["PATH"] = os.path.dirname(os.path.abspath(shutil.which(tool) or tool)) + os.pathsep + env.get("PATH", "")
    return env


def retarget_d(build_sh, dc_path, kind):
    """Rewrite a D build script to use compiler dc_path. Returns the new text or None."""
    text = build_sh
    new = re.sub(r"--compiler=(\"[^\"]*\"|'[^']*'|\S+)", f"--compiler={dc_path}", text)
    # A compiler used as a command word: optionally a path, but never part of an
    # option such as --compiler=..., which is handled above.
    cmd_re = re.compile(r"(^|[\s;&|(]|exec\s)(?:[^\s=\-\"'][^\s=]*/)?(ldc2|ldmd2|dmd)(?=\s)", re.M)

    def swap(m):
        return f"{m.group(1)}\"{dc_path}\""
    new = "".join(line if line.lstrip().startswith("#") else cmd_re.sub(swap, line)
                  for line in new.splitlines(keepends=True))
    if kind == "dmd":
        new = re.sub(r"--boundscheck=", "-boundscheck=", new)
        new = re.sub(r"(\s)-O[23s]?(\s)", r"\1-O\2", new)
        new = re.sub(r"\s-mcpu=\S+|\s--?flto=\S+|\s--ffast-math", "", new)
    else:
        new = re.sub(r"(\s)-inline(\s)", r"\1-enable-inlining\2", new)
        new = re.sub(r"(\s)-boundscheck=", r"\1--boundscheck=", new)
    has_compiler = re.search(r"--compiler=", text) or any(
        cmd_re.search(line) for line in text.splitlines() if not line.lstrip().startswith("#"))
    return new if has_compiler else None


# ---------------------------------------------------------------- measuring

@functools.lru_cache(maxsize=None)
def perf_usable():
    """Whether `perf stat` runs here. Ubuntu's linux-tools wrapper is on PATH even when no perf matches the
    running kernel, and then fails every command it wraps."""
    if not shutil.which("perf"):
        return False
    try:
        return subprocess.run(["perf", "stat", "-x", ",", "-e", "task-clock", "-o", os.devnull, "--", "true"],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def counter_prefix(log, append=False):
    """Command prefix that records the process's own instructions retired and cycles into `log`:
    BSD /usr/bin/time -l on macOS, `perf stat` on Linux; empty when neither is available."""
    if sys.platform == "darwin":
        return ["/usr/bin/time", "-l"] + (["-a"] if append else []) + ["-o", log]
    if perf_usable():
        return (["perf", "stat", "-x", ",", "-e", "task-clock,instructions,cycles"]
                + (["--append"] if append else []) + ["-o", log, "--"])
    return []


def parse_counter_log(text):
    return parse_time_log(text) if sys.platform == "darwin" else parse_perf_stat(text)


def timed(cmd, cwd, stdin_path=None, stdout_path=None, timeout=None, env=None):
    """Run cmd with hardware counters. Returns a dict with rc, wall, cpu, instr, cycles, rss (bytes).

    The child is reaped with a blocking os.wait4, so wall time is exact; Popen.wait(timeout) polls
    with back-off up to 50 ms, which would bunch short runs at its poll instants. A timer enforces
    the timeout by killing the process group, and rc is then None."""
    with tempfile.NamedTemporaryFile("r", suffix=".counters", delete=False) as tf:
        tpath = tf.name
    fin = open(stdin_path, "rb") if stdin_path else subprocess.DEVNULL
    fout = open(stdout_path, "wb") if stdout_path else subprocess.DEVNULL
    start = time.perf_counter()
    proc = subprocess.Popen(counter_prefix(tpath) + cmd, cwd=cwd, stdin=fin, stdout=fout,
                            stderr=subprocess.DEVNULL, start_new_session=True, env=env)
    killed = []

    def kill():
        killed.append(True)
        try:
            os.killpg(proc.pid, 9)
        except ProcessLookupError:
            pass
    timer = threading.Timer(timeout, kill) if timeout else None
    if timer:
        timer.start()
    _, status, usage = os.wait4(proc.pid, 0)
    wall = time.perf_counter() - start
    if timer:
        timer.cancel()
    proc.returncode = os.waitstatus_to_exitcode(status)
    rc = None if killed else proc.returncode
    for f in (fin, fout):
        if hasattr(f, "close"):
            f.close()
    txt = open(tpath).read()
    os.unlink(tpath)
    counters = parse_counter_log(txt)
    rss = usage.ru_maxrss if sys.platform == "darwin" else usage.ru_maxrss * 1024
    return {"rc": rc, "wall": wall, "cpu": usage.ru_utime + usage.ru_stime,
            "instr": float(counters["instr"]), "cycles": float(counters["cycles"]), "rss": float(rss)}


def parse_perf_stat(text):
    """Sum `perf stat -x ,` reports (one per run, possibly appended to one log)."""
    instr = cycles = 0
    cpu_ms = 0.0
    runs = 0
    for line in text.splitlines():
        f = line.split(",")
        if len(f) < 3 or line.startswith("#"):
            continue
        event = f[2].split(":")[0]
        try:
            v = float(f[0])
        except ValueError:
            v = 0.0
        if event == "instructions":
            instr += int(v)
            runs += 1
        elif event == "cycles":
            cycles += int(v)
        elif event == "task-clock":
            cpu_ms += v
    return {"invocations": runs, "instr": instr, "cycles": cycles, "cpu": round(cpu_ms / 1000.0, 6)}


def parse_time_log(text):
    """Sum the /usr/bin/time -l reports appended to one log, one per compiler invocation.

    Instruction and cycle counts cover only the measured process itself, so the
    compiler is measured directly (through a wrapper) rather than through dub or a shell."""
    instr = [int(x) for x in re.findall(r"(\d+)\s+instructions retired", text)]
    cycles = [int(x) for x in re.findall(r"(\d+)\s+cycles elapsed", text)]
    cpu = sum(float(u) + float(sy) for u, sy in re.findall(r"([\d.]+) user\s+([\d.]+) sys", text))
    return {"invocations": len(instr), "instr": sum(instr), "cycles": sum(cycles), "cpu": round(cpu, 6)}


def compiler_wrapper(dc, where, extra=()):
    """A counting wrapper named like the D compiler (dub infers the compiler kind from the name).
    Flags in `extra` follow the build's own arguments, so they override them (e.g. -boundscheck=on
    after -release)."""
    name = "ldc2" if dc["kind"] == "ldc" else "dmd"
    return counting_wrapper(dc["path"], os.path.join(where, name), extra)


TIER_DIRS = {"short": "bench", "long": "bench-long"}


def bench_cases(slug, tier="short"):
    """A problem's benchmark inputs in one tier: short (bench/, the quick loop) or long (bench-long/,
    each input at least 5 s for the fastest implementation)."""
    tdir = os.path.join(ROOT, "problems", slug, TIER_DIRS[tier])
    entries = os.listdir(tdir) if os.path.isdir(tdir) else []
    dirs = sorted(d for d in entries if os.path.isdir(os.path.join(tdir, d, "input")))
    if dirs:
        return tdir, [(d, "dir") for d in dirs]
    files = [(f, "stdin") for f in sorted(entries) if f.endswith(".in")]
    if not files:
        target, flag = ("bench", "") if tier == "short" else ("bench-long", " --long")
        sys.exit(f"no {tier} benchmark data for {slug}: generate it once with `make {target}` "
                 f"(or `python3 problems/{slug}/bench/gen_bench.py{flag}`)")
    return tdir, files


def effective_tier(slug, tier):
    """The tier to run for one problem: the requested one, except that a problem with no long inputs (its
    work is proportional to data size beyond the budget) falls back to its short inputs."""
    if tier == "long" and not os.path.isdir(os.path.join(ROOT, "problems", slug, TIER_DIRS["long"])):
        return "short"
    return tier


def suite_tier(suite):
    return SUITES.get(suite, {}).get("tier", "long")


def suite_cases(suite, slug, tier=None):
    """The benchmark inputs a suite uses for one problem: all of them, or the one it names."""
    tdir, cases = bench_cases(slug, tier or suite_tier(suite))
    spec = SUITES.get(suite, {})
    want = spec.get("inputs", {}).get(slug)
    if want:
        return [c for c in cases if c[0] == want]
    return cases[:1] if spec.get("first_input") else cases


def run_defaults(suite):
    spec = SUITES.get(suite, {})
    return {"reps": spec.get("reps", 3), "warmup": spec.get("warmup", True)}


def run_case(run_sh, slug, tdir, name, mode, timeout, env=None):
    """Run one benchmark input; returns (status, measurement)."""
    pdir = os.path.join(ROOT, "problems", slug)
    verifier = os.path.join(pdir, "verify.py")
    if mode == "dir":
        case = os.path.join(tdir, name)
        out_dir = tempfile.mkdtemp(prefix="lbench_")
        try:
            m = timed([run_sh, os.path.join(case, "input"), out_dir], pdir, timeout=timeout, env=env)
            if m["rc"] is None:
                return "timeout", m
            if m["rc"] != 0:
                return "error", m
            expected = os.path.join(case, "expected")
            if os.path.exists(verifier):
                v = subprocess.run([sys.executable, verifier, os.path.join(case, "input"), out_dir]
                                   + ([expected] if os.path.isdir(expected) else []), capture_output=True)
                return ("ok" if v.returncode == 0 else "wrong"), m
            return ("ok" if run_tests.compare_trees(expected, out_dir) is None else "wrong"), m
        finally:
            shutil.rmtree(out_dir, ignore_errors=True)
    in_path = os.path.join(tdir, name)
    with tempfile.NamedTemporaryFile(suffix=".out", delete=False) as of:
        out_path = of.name
    try:
        m = timed([run_sh], pdir, stdin_path=in_path, stdout_path=out_path, timeout=timeout, env=env)
        if m["rc"] is None:
            return "timeout", m
        if m["rc"] != 0:
            return "error", m
        exp = in_path[:-3] + ".out"
        if os.path.exists(verifier):
            v = subprocess.run([sys.executable, verifier, in_path, out_path] + ([exp] if os.path.exists(exp) else []),
                               capture_output=True)
            return ("ok" if v.returncode == 0 else "wrong"), m
        a = open(out_path, encoding="utf-8", errors="replace").read()
        e = open(exp, encoding="utf-8").read()
        return ("ok" if run_tests.normalize(a) == run_tests.normalize(e) else "wrong"), m
    finally:
        os.unlink(out_path)


