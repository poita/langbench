# ---------------------------------------------------------------- selection

def problems_all():
    return sorted(d for d in os.listdir(os.path.join(ROOT, "problems"))
                  if os.path.isdir(os.path.join(ROOT, "problems", d, "bench")))


def select(suite, problems=None, langs=None, roots=None):
    """Return [(root, lang, slug)] for a suite, optionally filtered.

    Explicit roots (e.g. a freshly generated runs-new/rep1) replace the suite's
    roots and select every implementation found there."""
    spec = dict(SUITES[suite])
    if roots:
        spec.update(roots=list(roots), pick="all")
    langs = [l for l in spec["langs"] if not langs or l in langs]
    probs = [p for p in problems_all() if (not problems or p in problems)
             and ("inputs" not in spec or p in spec["inputs"])]
    out = []
    for lang in langs:
        for slug in probs:
            for root in spec["roots"]:
                if os.path.exists(os.path.join(ROOT, root, lang, slug, "run.sh")):
                    out.append((root, lang, slug))
                    if spec["pick"] == "one":
                        break
    return out


